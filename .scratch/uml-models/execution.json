      },
      {
        "from": "facade",
        "to": "gate",
        "type": "dependency",
        "label": "落实控制"
      },
      {
        "from": "worker",
        "to": "store",
        "type": "dependency",
        "label": "原责任／事实提交"
      },
      {
        "from": "worker",
        "to": "gate",
        "type": "dependency",
        "label": "最新启动检查"
      },
      {
        "from": "gate",
        "to": "owner",
        "type": "dependency",
        "label": "Gate / epoch"
      },
      {
        "from": "gate",
        "to": "driver",
        "type": "dependency",
        "label": "获准后发送"
      },
      {
        "from": "worker",
        "to": "driver",
        "type": "dependency",
        "label": "原目标查询／取消"
      },
