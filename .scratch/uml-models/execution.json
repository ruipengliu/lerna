    "edges": [
      {
        "from": "facade",
        "to": "api",
        "type": "realization",
        "label": "提供"
      },
      {
        "from": "facade",
        "to": "catalog",
        "type": "dependency",
        "label": "准确声明"
      },
      {
        "from": "facade",
        "to": "store",
        "type": "dependency",
