{
  "module": "extensions",
  "title": "宿主装配、首装与组件切换",
  "component": {
    "nodes": [
      {
        "id": "api",
        "name": "Extensions API",
        "kind": "interface",
        "boundary": "provided",
        "methods": [
          "extensions.prepare",
          "extensions.activate",
          "extensions.deactivate",
          "extensions.read",
          "extensions.dispose"
        ],
        "source": "contracts/schemas/methods.json"
      },
      {
        "id": "lifecycle",
        "name": "extensions facade / LifecycleManager",
        "kind": "component",
        "boundary": "internal",
        "source": "extensions/implementation.md#module-shape"
      },
      {
        "id": "verifier",
        "name": "PackageVerifier / ArtifactReader",
        "kind": "component",
        "boundary": "internal",
        "source": "extensions/implementation.md#module-shape"
      },
      {
        "id": "store",
        "name": "LockStore / 宿主 repositories",
        "kind": "component",
        "boundary": "internal",
        "source": "extensions/implementation.md#module-shape"
      },
      {
        "id": "references",
        "name": "ReferenceCollector",
        "kind": "component",
        "boundary": "internal",
        "source": "extensions/implementation.md#module-shape"
      },
      {
        "id": "router",
        "name": "BindingRouter",
        "kind": "component",
        "boundary": "internal",
        "source": "extensions/implementation.md#module-shape"
      },
      {
        "id": "approval",
        "name": "ApprovalClient",
        "kind": "component",
        "boundary": "internal",
        "source": "extensions/implementation.md#module-shape"
      },
      {
        "id": "content",
        "name": "宿主内容 port",
        "kind": "interface",
        "boundary": "required",
        "methods": [],
        "source": "extensions/implementation.md#module-shape"
      },
      {
        "id": "approval_api",
        "name": "Evaluation API（远端启动依据）",
        "kind": "interface",
        "boundary": "required",
        "methods": [
          "evaluation.approval_check",
          "evaluation.approval_lease"
        ],
        "source": "contracts/schemas/methods.json"
      }
    ],
    "edges": [
      {
        "from": "lifecycle",
        "to": "api",
        "type": "realization",
        "label": "提供"
      },
      {
        "from": "lifecycle",
        "to": "verifier",
        "type": "dependency",
        "label": "准备与核验"
      },
      {
        "from": "verifier",
        "to": "content",
        "type": "dependency",
        "label": "准确内容与摘要"
      },
      {
        "from": "lifecycle",
        "to": "store",
        "type": "dependency",
        "label": "锁、步骤与持久 jobs"
      },
      {
        "from": "lifecycle",
        "to": "references",
        "type": "dependency",
        "label": "排空与释放事实"
      },
      {
        "from": "lifecycle",
        "to": "router",
        "type": "dependency",
        "label": "关闭或开放入口"
      },
      {
        "from": "lifecycle",
        "to": "approval",
        "type": "dependency",
        "label": "当前批准与启动依据"
      },
      {
        "from": "approval",
        "to": "approval_api",
        "type": "dependency",
        "label": "原使用 / 窗口"
      },
      {
        "from": "references",
        "to": "store",
        "type": "dependency",
        "label": "引用索引及修订"
      },
      {
        "from": "router",
        "to": "store",
        "type": "dependency",
        "label": "当前绑定 / 就绪"
      }
    ],
    "notes": [
      "management_jobs 恢复原步骤；下载、装载、排空核对等外部操作在事务外。",
      "批准 owner 共库时直接参与本地启动事务；远端使用有限依据，租约仅显式获准时适用。",
      "组件是参考职责；业务入口同时要求批准有效、当前代际和本实例真实就绪。"
    ]
  },
  "data": {
