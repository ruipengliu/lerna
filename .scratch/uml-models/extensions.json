    "edges": [
      {
        "from": "manifest",
        "to": "lock",
        "type": "association",
        "fromMultiplicity": "1",
        "toMultiplicity": "0..*",
        "label": "精确清单",
        "source": "contracts/schemas/protocol.schema.json#/$defs/InstallLock"
      },
      {
        "from": "lock",
        "to": "activation",
        "type": "association",
        "fromMultiplicity": "1",
        "toMultiplicity": "0..*",
        "label": "new_lock_id",
        "source": "contracts/schemas/protocol.schema.json#/$defs/Activation"
      },
      {
        "from": "lock",
        "to": "activation",
        "type": "association",
        "fromMultiplicity": "0..1",
        "toMultiplicity": "0..*",
        "label": "old_lock_id",
        "source": "contracts/schemas/protocol.schema.json#/$defs/Activation",
        "constraint": "首次安装 old_lock_id=null"
      },
      {
        "from": "approval",
        "to": "activation",
        "type": "association",
        "fromMultiplicity": "1",
        "toMultiplicity": "0..*",
        "label": "精确批准",
        "source": "contracts/schemas/protocol.schema.json#/$defs/Activation",
        "constraint": "跨 owner；当前有效性由 Evaluation 裁决，历史引用不授予新启动资格"
      },
      {
        "from": "lock",
        "to": "binding",
        "type": "association",
        "fromMultiplicity": "1",
        "toMultiplicity": "0..*",
        "label": "当前 lock_id",
        "source": "extensions/implementation.md#4-管理账本与索引",
        "constraint": "每 target_id / port 仅一个当前 generation"
      },
      {
        "from": "activation",
        "to": "readiness",
        "type": "association",
        "fromMultiplicity": "1",
        "toMultiplicity": "0..1",
        "label": "当前就绪投影",
        "source": "contracts/schemas/protocol.schema.json#/$defs/Activation",
        "constraint": "仅当前查询投影；phase=active 必须存在且为本实例 ready"
      },
      {
        "from": "lock",
        "to": "reference",
        "type": "association",
        "fromMultiplicity": "1",
        "toMultiplicity": "0..*",
        "label": "持有版本锁",
        "source": "extensions/implementation.md#4-管理账本与索引",
        "constraint": "(lock_id, owner_kind, owner_id) 唯一；不是销毁级联"
      }
    ],
    "notes": [
      "prepare 形成不可变安装锁；激活意图、当前活动指针与当前实例就绪分别确认。",
      "重启保留 Activation.startup_evidence 与 generation，重新取得本实例 reopen 依据。",
      "LockReference 是跨 owner 索引；任一持有者未知时不能按零引用清理旧锁。"
    ]
  },
  "reading_notes": [
    "组件页保留准备、引用、生命周期、批准适配与真实派发门禁。ReferenceCollector 还在事务外查询各业务持有者；图中省略这些展开端口，完整依赖见实现篇。内容 port 为内部适配器边界，不新增线方法。",
    "InstallLock 的 manifest、配置与完整依赖固定；本图仅选关键属性。相同清单可以有多个平台或配置锁；首装 Activation 无旧锁，已准备锁可以尚未被任何激活或活动绑定使用。",
    "Activation 是原切换身份与历史依据；ActiveBinding 是每个 target / port 当前唯一指针。InstanceReadiness 的 0..1 只描述 Activation 查询中的当前投影，不限制多次重启可保存的历史实例检查记录数量。图不把历史 Activation 删除或改写为当前进程成功。",
    "正常切换需排空、核验批准并装载，自检及本实例真实入口满足后才能 active。活动指针提交后崩溃，恢复原锁与代际，新的 reopen 依据恢复当前实例，不再次迁移或推进 generation。",
    "获知撤回，或当前检查不可用且没有仍有效的有限启动／离线续用依据时，关闭相应新使用；管理与原责任核对继续。共库批准与启动共同裁决；远端重启不能沿用旧实例 ApprovalUse 或离线租约。历史 Activation 与已发生效果继续保留。",
    "LockReference 的 owner_kind / owner_id 指向任务、原操作、迁移或回退等持有责任；扩展本地索引不能代替这些 owner 的释放事实。dispose 与新引用比较 reference_revision，失联或未知引用保持旧包；清理字节后原管理关闭索引仍保留。",
    "ActiveBinding 与 LockReference 为内部记录，schema=null；本图只作领域投影，不主张数据库外键、组合生命周期或级联删除。"
  ],
