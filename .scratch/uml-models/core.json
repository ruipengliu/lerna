        "from": "task",
        "to": "result",
        "type": "association",
        "fromMultiplicity": "1",
        "toMultiplicity": "0..1",
        "label": "完成时固定",
        "source": "task-runtime/implementation.md#data-flow",
        "constraint": "当前目标正式结果仅在 Task.status=succeeded 时存在"
      },
      {
        "from": "result",
        "to": "content",
        "type": "association",
        "fromMultiplicity": "0..*",
        "toMultiplicity": "1..100",
        "label": "成果引用",
        "source": "task-runtime/README.md",
        "constraint": "引用可复用，不表示内容生命周期所有权"
