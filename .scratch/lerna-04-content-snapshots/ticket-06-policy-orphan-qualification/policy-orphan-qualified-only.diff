+func TestContentSIGKILLWithCurrentSaveWithdrawalRecoversOriginalOrphanDuty(t *testing.T) {
+	for _, kill := range []bool{false, true} {
+		name := "normal_release"
+		if kill {
+			name = "SIGKILL_then_current_save_withdrawal"
+		}
+		t.Run(name, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+			defer cancel()
+			originalTrust, _ := ctx.Deadline()
+			w := fixture.New(t, ctx)
+			management := content.ManagementConfig{Owner: contentOwner, Store: w.Store(), TrustedSubject: contentPrincipal, TrustedUntil: originalTrust, PageSize: 2, WorkBudget: 20 * time.Second}
+			manager, err := content.NewManager(management)
+			if err != nil {
+				t.Fatal("original finite policy manager:", contentProcessCauseClasses(err))
+			}
+			wide := time.Now().Add(time.Hour).UTC().Truncate(time.Microsecond)
+			policy := content.FixturePolicy{Ref: alphaRef, Subject: contentPrincipal, Purpose: "verification", Revision: 1, ValidUntil: wide, RetainUntil: wide, Read: true, Process: true, Save: true, Sync: true, Disclose: true}
+			initial, err := manager.InstallPolicy(ctx, &contentPrincipal, policy, 0)
+			if err != nil {
+				t.Fatal("original actual policy admission:", contentProcessCauseClasses(err))
+			}
+			if err = w.Store().InstallFixtureCommandReader(ctx, contentOwner, contentPrincipal, originalTrust); err != nil {
+				t.Fatal("original finite Command reader fixture:", contentProcessCauseClasses(err))
+			}
+			service, err := publicationProcessService(w.Store(), w.Objects, "original-policy-recovery-parent")
+			if err != nil {
+				t.Fatal("original publication service:", contentProcessCauseClasses(err))
+			}
+			request := contentPut(t, alphaRef, "original-policy-recovery-publication", "YWxwaGEK")
+			receipt := putContentRequest(t, ctx, service, request)
+			if _, ok := receipt.AsAccepted(); !ok {
+				t.Fatal("original policy-qualified publication not accepted")
+			}
+			fixed, err := v.Encode(receipt)
+			if err != nil {
+				t.Fatal("original fixed receipt encoding:", contentProcessCauseClasses(err))
+			}
+			assertCommand := func(publication string) {
+				t.Helper()
+				result, cause := service.GetCommand(ctx, contentCommandGetWire(t, request.CommandID), &contentPrincipal)
+				if cause != nil {
+					t.Fatal("original command observer:", contentProcessCauseClasses(cause))
+				}
+				found, ok := result.AsFound()
+				if !ok {
+					t.Fatal("original fixed command receipt missing")
+				}
+				encoded, cause := v.Encode(found.Receipt)
+				progress, present := found.Progress.AsContent()
+				if cause != nil || string(encoded) != string(fixed) || !present || progress.ContentRef != alphaRef || progress.Publication != publication {
+					t.Fatal("original receipt/progress changed across policy recovery")
+				}
+			}
+			_, key, err := content.VersionIdentity(alphaRef)
+			if err != nil {
+				t.Fatal("original full version identity:", contentProcessCauseClasses(err))
+			}
+			assertOriginalBytes := func() {
+				t.Helper()
+				actual, cause := os.ReadFile(filepath.Join(w.Directory, key))
+				if cause != nil || string(actual) != "alpha\n" {
+					t.Fatal("independent original complete key bytes missing")
+				}
+			}
+			makeLifecycle := func() *content.Lifecycle {
+				t.Helper()
+				// Reopen replaces concrete handles only; original trust/workbudget stays.
+				management.Store = w.Store()
+				lifecycle, cause := content.NewLifecycle(content.LifecycleConfig{ManagementConfig: management, PrimaryHolderID: "primary", Objects: w.Objects, Worker: "original-policy-orphan-cleanup"})
+				if cause != nil {
+					t.Fatal("original finite orphan lifecycle:", contentProcessCauseClasses(cause))
+				}
+				return lifecycle
+			}
+			child := startContentPublicationChild(t, ctx, w, "durable_before_publication", 1)
+			var gate contentProcessFrame
+			if err = child.Event(ctx, &gate); err != nil {
+				t.Fatal("same original durable publication gate:", contentProcessCauseClasses(err))
+			}
+			if gate.Scenario != "original-content-publication" || gate.Generation != 1 || gate.Stage != "durable_before_publication" || gate.ObjectKey != key || gate.Attempt == "" || gate.LeaseUntil.IsZero() {
+				t.Fatal("original durable policy recovery gate identity mismatch")
+			}
+			assertOriginalBytes()
+			if !kill {
+				if err = child.Send(ctx, contentProcessFrame{Scenario: gate.Scenario, Generation: 1, Stage: "release"}); err != nil {
+					t.Fatal("normal same-gate release:", contentProcessCauseClasses(err))
+				}
+				finishContentPublicationChild(t, ctx, w, child, 1)
+				w.Reopen(ctx)
+				service, err = publicationProcessService(w.Store(), w.Objects, "normal-policy-recovery-observer")
+				if err != nil {
+					t.Fatal("normal reopened service:", contentProcessCauseClasses(err))
+				}
+				assertContentBody(t, ctx, service, alphaRef, nil, "alpha\n")
+				assertCommand("published")
+				assertOriginalBytes()
+				lifecycle := makeLifecycle()
+				refused := content.SealRequest{Ref: alphaRef, Purpose: "verification", SealID: "live-original-policy-orphan-refusal", Deadline: initial.Deadline}
+				if _, err = lifecycle.SealOrphan(ctx, &contentPrincipal, refused); !errors.Is(err, content.ErrOrphanReferenced) {
+					t.Fatal("live original publication did not refuse orphan:", contentProcessCauseClasses(err))
+				}
+				if _, err = lifecycle.Observe(ctx, &contentPrincipal, alphaRef, ""); !errors.Is(err, content.ErrUnavailable) {
+					t.Fatal("live orphan refusal created a seal")
+				}
+				if worked, cause := lifecycle.Step(ctx, &contentPrincipal); cause != nil || worked {
+					t.Fatal("live orphan refusal created cleanup work:", contentProcessCauseClasses(cause))
+				}
+				assertContentBody(t, ctx, service, alphaRef, nil, "alpha\n")
+				assertCommand("published")
+				assertExactContentObjects(t, w.Directory, map[v.ContentRef]string{alphaRef: "alpha\n"})
+				return
+			}
+			cutoff, stop := context.WithTimeout(ctx, 3*time.Second)
+			if err = child.KillWait(cutoff); err != nil {
+				stop()
+				t.Fatal("original durable policy SIGKILL/Wait:", contentProcessCauseClasses(err))
+			}
+			if err = w.RetainChildNativeClose(child); err != nil {
+				stop()
+				t.Fatal("original killed native Close retention:", contentProcessCauseClasses(err))
+			}
+			var lost contentProcessFrame
+			if err = child.Reply(cutoff, &lost); !errors.Is(err, io.EOF) {
+				stop()
+				t.Fatal("original killed policy reply not EOF:", contentProcessCauseClasses(err))
+			}
+			confirmed, closeErr := child.Stop(cutoff)
+			stop()
+			if !confirmed || closeErr != nil {
+				t.Fatal("original killed physical pipe Close:", contentProcessCauseClasses(closeErr))
+			}
+			w.Reopen(ctx)
+			service, err = publicationProcessService(w.Store(), w.Objects, "policy-withdrawal-preparing-observer")
+			if err != nil {
+				t.Fatal("pre-withdrawal reopened service:", contentProcessCauseClasses(err))
+			}
+			preparing, cause := service.Get(ctx, contentGetWire(t, alphaRef, nil), &contentPrincipal)
+			pending, ok := preparing.AsPreparing()
+			if cause != nil || !ok || pending.ContentRef != alphaRef {
+				t.Fatal("killed original durable attempt was incorrectly published")
+			}
+			assertCommand("preparing")
+			assertOriginalBytes()
+			management.Store = w.Store()
+			manager, err = content.NewManager(management)
+			if err != nil {
+				t.Fatal("same original policy authority:", contentProcessCauseClasses(err))
+			}
+			// The actual management entry changes only Save/revision. No absent policy,
+			// lease manipulation, cap renewal or fixture record injection substitutes.
+			policy.Revision = 2
+			policy.Save = false
+			change, err := manager.InstallPolicy(ctx, &contentPrincipal, policy, 1)
+			if err != nil {
+				t.Fatal("actual current original Save withdrawal:", contentProcessCauseClasses(err))
+			}
+			before, err := manager.ObserveChange(ctx, &contentPrincipal, change.Key, "", 2)
+			if err != nil || len(before.Responsibilities) != 1 || before.NextCursor != "" {
+				t.Fatal("original policy duty page:", contentProcessCauseClasses(err))
+			}
+			original := before.Responsibilities[0]
+			if original.ChangeKey != change.Key || original.Ref != alphaRef || !reflect.DeepEqual(original.Subject, contentPrincipal) || original.Purpose != "verification" || !original.Deadline.Equal(change.Deadline) || original.BodyCleanup != "pending" || original.Residual != "holder_unconfirmed" || original.AttemptKey != gate.Attempt || original.Publication != "preparing" || !original.StagingHolder || original.ObjectHolder || !reflect.DeepEqual(original.Actions, []string{"save"}) || original.Reason != "" {
+				t.Fatal("actual withdrawal rewrote original attempt responsibility")
+			}
+			wait := time.Until(gate.LeaseUntil.Add(time.Millisecond))
+			if wait > 0 {
+				timer := time.NewTimer(wait)
+				defer timer.Stop()
+				select {
+				case <-timer.C:
+				case <-ctx.Done():
+					t.Fatal("original natural lease expiry:", contentProcessCauseClasses(ctx.Err()))
+				}
+			}
+			successor := startContentPublicationChild(t, ctx, w, "", 2)
+			finishContentPublicationChild(t, ctx, w, successor, 2)
+			w.Reopen(ctx)
+			service, err = publicationProcessService(w.Store(), w.Objects, "original-policy-failed-observer")
+			if err != nil {
+				t.Fatal("original failed observer:", contentProcessCauseClasses(err))
+			}
+			failed, cause := service.Get(ctx, contentGetWire(t, alphaRef, nil), &contentPrincipal)
+			failure, ok := failed.AsFailed()
+			if cause != nil || !ok || failure.ContentRef != alphaRef || failure.Reason != "forbidden" {
+				t.Fatal("current Save withdrawal did not prevent original publication")
+			}
+			assertCommand("failed")
+			assertOriginalBytes()
+			lifecycle := makeLifecycle()
+			staging, err := lifecycle.ObserveStaging(ctx, &contentPrincipal, alphaRef)
+			if err != nil || staging.Ref != alphaRef || !staging.Present {
+				t.Fatal("failed original persistent staging missing:", contentProcessCauseClasses(err))
+			}
+			seal := content.SealRequest{Ref: alphaRef, Purpose: "verification", SealID: "original-policy-failed-orphan", Deadline: change.Deadline}
+			if _, err = lifecycle.SealOrphan(ctx, &contentPrincipal, seal); err != nil {
+				t.Fatal("original exact-deadline orphan seal:", contentProcessCauseClasses(err))
+			}
+			observe := func() content.BodyCleanupObservation {
+				t.Helper()
+				observed, cause := lifecycle.Observe(ctx, &contentPrincipal, alphaRef, "")
+				if cause != nil {
+					t.Fatal("original orphan duty observer:", contentProcessCauseClasses(cause))
+				}
+				actual := observed.Seal
+				if actual.ID != seal.SealID || actual.Ref != alphaRef || actual.Purpose != "verification" || !reflect.DeepEqual(actual.Subject, contentPrincipal) || actual.PolicyChangeKey != "" || actual.PrimaryHolderID != "primary" || actual.PrimaryHolderBinding != w.Objects.Binding() || !actual.Deadline.Equal(change.Deadline) || observed.NextCursor != "" || len(observed.Holders) != 2 {
+					t.Fatal("original orphan duty identity/deadline changed")
+				}
+				seen := map[string]bool{}
+				for _, holder := range observed.Holders {
+					identity := holder.Identity
+					if identity.Ref != alphaRef || identity.ObjectKey != key || identity.SealID != seal.SealID || !holder.Deadline.Equal(change.Deadline) || seen[identity.HolderID] {
+						t.Fatal("original holder identity/deadline changed")
+					}
+					seen[identity.HolderID] = true
+					switch holder.Kind {
+					case "pg-staging":
+						if identity.HolderID != "postgres-staging" || identity.Binding != "" || holder.Responsible != "postgres-staging" {
+							t.Fatal("original staging holder changed")
+						}
+					case "primary":
+						if identity.HolderID != "primary" || identity.Binding != w.Objects.Binding() || holder.Responsible != "primary" {
+							t.Fatal("original primary holder changed")
+						}
+					default:
+						t.Fatal("orphan acquired an invented holder")
+					}
+					if holder.State == "erased" && holder.Reason != "" {
+						t.Fatal("erased holder retained a current residual")
+					}
+				}
+				if !seen["primary"] || !seen["postgres-staging"] {
+					t.Fatal("original orphan responsibilities incomplete")
+				}
+				return observed
+			}
+			observed := observe()
+			if observed.CleanupComplete {
+				t.Fatal("orphan seal falsely acknowledged actual erasure")
+			}
+			assertOriginalBytes()
+			state := func(observation content.BodyCleanupObservation, kind string) string {
+				for _, holder := range observation.Holders {
+					if holder.Kind == kind {
+						return holder.State
+					}
+				}
+				return ""
+			}
+			checkPhysical := func(observation content.BodyCleanupObservation) {
+				t.Helper()
+				actual, cause := lifecycle.ObserveStaging(ctx, &contentPrincipal, alphaRef)
+				if cause != nil || actual.Ref != alphaRef {
+					t.Fatal("independent original staging observation:", contentProcessCauseClasses(cause))
+				}
+				if state(observation, "pg-staging") == "erased" && actual.Present {
+					t.Fatal("erased original staging remains readable")
+				}
+				if state(observation, "primary") == "erased" {
+					if _, cause = os.ReadFile(filepath.Join(w.Directory, key)); !errors.Is(cause, os.ErrNotExist) {
+						t.Fatal("erased original primary bytes remain")
+					}
+					for _, holder := range observation.Holders {
+						if holder.Kind == "primary" {
+							physical, cause := w.Objects.ObserveErasure(ctx, holder.Identity, "", 2)
+							if cause != nil || physical.Identity != holder.Identity || !physical.Fenced || !physical.Erased || physical.NextCursor != "" || len(physical.Residual) != 0 {
+								t.Fatal("independent original primary erasure unconfirmed:", contentProcessCauseClasses(cause))
+							}
+						}
+					}
+				}
+			}
+			for i := 0; i < 4 && !observed.CleanupComplete; i++ {
+				previous := observed
+				worked, cause := lifecycle.Step(ctx, &contentPrincipal)
+				if cause != nil {
+					t.Fatal("original cleanup effect/residual:", contentProcessCauseClasses(cause))
+				}
+				observed = observe()
+				checkPhysical(observed)
+				if !worked && !observed.CleanupComplete {
+					t.Fatal("original orphan work stopped before actual all-holder ACK")
+				}
+				// Observe the true transition and its untouched counterpart; no assumed
+				// holder-kind order or call count is a business erasure oracle.
+				if state(previous, "pg-staging") != "erased" && state(observed, "pg-staging") == "erased" && state(observed, "primary") != "erased" {
+					assertOriginalBytes()
+					t.Log("original staging erased; independent primary full bytes remain")
+				}
+				if state(previous, "primary") != "erased" && state(observed, "primary") == "erased" && state(observed, "pg-staging") != "erased" {
+					counterpart, cause := lifecycle.ObserveStaging(ctx, &contentPrincipal, alphaRef)
+					if cause != nil || !counterpart.Present {
+						t.Fatal("primary transition rewrote pending original staging")
+					}
+					t.Log("original primary erased; independent original staging remains")
+				}
+			}
+			if !observed.CleanupComplete || state(observed, "pg-staging") != "erased" || state(observed, "primary") != "erased" {
+				t.Fatal("original orphan did not reach actual all-holder ACK within finite ceiling")
+			}
+			checkPhysical(observed)
+			w.Reopen(ctx)
+			service, err = publicationProcessService(w.Store(), w.Objects, "original-orphan-reopened-observer")
+			if err != nil {
+				t.Fatal("orphan reopened service:", contentProcessCauseClasses(err))
+			}
+			lifecycle = makeLifecycle()
+			observed = observe()
+			if !observed.CleanupComplete || state(observed, "pg-staging") != "erased" || state(observed, "primary") != "erased" {
+				t.Fatal("actual reopen lost original orphan allACK")
+			}
+			checkPhysical(observed)
+			metadata := content.MetadataPolicy{Ref: alphaRef, Subject: contentPrincipal, Purpose: "verification", Revision: 1, ValidUntil: originalTrust}
+			if err = lifecycle.InstallMetadataPolicy(ctx, &contentPrincipal, metadata, 0); err != nil {
+				t.Fatal("current exact metadata authority:", contentProcessCauseClasses(err))
+			}
+			view, cause := service.Get(ctx, contentGetWire(t, alphaRef, nil), &contentPrincipal)
+			gone, ok := view.AsGone()
+			if cause != nil || !ok || gone.ContentRef != alphaRef || gone.EvidenceAvailable {
+				t.Fatal("actual original allACK did not expose qualified metadata Gone")
+			}
+			assertCommand("failed")
+			management.Store = w.Store()
+			manager, err = content.NewManager(management)
+			if err != nil {
+				t.Fatal("same original policy reconciliation authority:", contentProcessCauseClasses(err))
+			}
+			after, err := manager.ObserveChange(ctx, &contentPrincipal, change.Key, "", 2)
+			if err != nil || after.NextCursor != "" || len(after.Responsibilities) != 1 || !reflect.DeepEqual(after.Responsibilities[0], original) || !reflect.DeepEqual(after.Change.Policy, policy) || !after.Change.Deadline.Equal(change.Deadline) {
+				t.Fatal("orphan ACK falsely discharged/replaced original policy duty:", contentProcessCauseClasses(err))
+			}
+		})
+	}
+}
+
 var _ content.Repository = (*contentProcessStore)(nil)
 var _ content.Objects = (*contentProcessObjects)(nil)
