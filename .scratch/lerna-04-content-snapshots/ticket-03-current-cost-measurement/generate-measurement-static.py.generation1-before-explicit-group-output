# Fixed counters, no per-row storage/logs/body, no goroutine/SQL. Fully finite roles/phases/categories.
recorder='''
type qualificationAggregate struct {
	Attempted, Completed, ErrorReturns int
	Total, Max time.Duration
	FirstCause string
}
var qualificationRoles = [7]string{"shell", "mandatory", "lock", "manifest", "material", "worker-verification", "outer-readback"}
var qualificationPhases = [3]string{"pre", "post", "read"}
var qualificationStages = [13]string{"lock.identity_key", "lock.advisory_sql", "lock.row_sql", "lock.decode_validate", "policy.subject_prep", "policy.locked_sql", "policy.decode_actions", "now.sql", "callback", "within", "objects.read", "integrity", "read.total"}
func qualificationIndex(role, phase, stage string) (int, int, int) {
	r, p, s := -1, -1, -1
	for i, v := range qualificationRoles { if v == role { r = i; break } }
	for i, v := range qualificationPhases { if v == phase { p = i; break } }
	for i, v := range qualificationStages { if v == stage { s = i; break } }
	return r, p, s
}
func (d *ContextClaimDiagnostics) BeginContentQualification(role, phase, stage string) {
	if d == nil { return }
	started := time.Now()
	d.mu.Lock()
	defer d.mu.Unlock()
	r, p, s := qualificationIndex(role, phase, stage)
	if r < 0 || p < 0 || s < 0 { d.qualificationDropped++; d.qualificationAmbiguous++ } else { d.qualification[r][p][s].Attempted++ }
	d.qualificationHookCalls++
	d.qualificationHookElapsed += time.Since(started)
}
func (d *ContextClaimDiagnostics) EndContentQualification(role, phase, stage string, elapsed time.Duration, err error) {
	if d == nil { return }
	started := time.Now()
	d.mu.Lock()
	defer d.mu.Unlock()
	r, p, s := qualificationIndex(role, phase, stage)
	if r < 0 || p < 0 || s < 0 { d.qualificationDropped++; d.qualificationAmbiguous++ } else {
		a := &d.qualification[r][p][s]
		a.Completed++
		a.Total += elapsed
		if elapsed > a.Max { a.Max = elapsed }
		if err != nil { a.ErrorReturns++; if a.FirstCause == "" { a.FirstCause = claimCause(err) } }
	}
	d.qualificationHookCalls++
	d.qualificationHookElapsed += time.Since(started)
}
func (d *ContextClaimDiagnostics) qualificationSummary(t *testing.T) {
	t.Logf("QUAL_SQL case=%s fixed_slots=273 hooks=%d recorder_hook_wall=%s dropped=%d ambiguous=%d overhead_outside_recorder_unknown=true no_parent_child_sum=true", d.qualificationCase, d.qualificationHookCalls, d.qualificationHookElapsed, d.qualificationDropped, d.qualificationAmbiguous)
	for r, role := range qualificationRoles {
		for p, phase := range qualificationPhases {
			var serial time.Duration
			for s, stage := range qualificationStages {
				a := d.qualification[r][p][s]
				if a.Attempted == 0 && a.Completed == 0 { continue }
				first := a.FirstCause
				if first == "" { first = "nil" }
				t.Logf("QUAL_SQL case=%s role=%s phase=%s stage=%s attempted=%d completed=%d error_returns=%d wall=%s max=%s first_cause=%s", d.qualificationCase, role, phase, stage, a.Attempted, a.Completed, a.ErrorReturns, a.Total, a.Max, first)
				if s < 8 { serial += a.Total }
			}
			callback := d.qualification[r][p][8]
			within := d.qualification[r][p][9]
			if callback.Attempted > 0 || within.Attempted > 0 {
				t.Logf("QUAL_SQL case=%s role=%s phase=%s derived_serial_leaf_wall=%s callback_remaining=%s within_minus_callback=%s residual_not_proven_SQLwait=true callback_attempted=%d callback_completed=%d within_attempted=%d within_completed=%d", d.qualificationCase, role, phase, serial, callback.Total-serial, within.Total-callback.Total, callback.Attempted, callback.Completed, within.Attempted, within.Completed)
			}
		}
	}
}
