+type qualificationAggregate struct {
+	Attempted, Completed, ErrorReturns int
+	Total, Max                         time.Duration
+	FirstCause                         string
+}
+
+var qualificationRoles = [7]string{"shell", "mandatory", "lock", "manifest", "material", "worker-verification", "outer-readback"}
+var qualificationPhases = [3]string{"pre", "post", "read"}
+var qualificationStages = [13]string{"lock.identity_key", "lock.advisory_sql", "lock.row_sql", "lock.decode_validate", "policy.subject_prep", "policy.locked_sql", "policy.decode_actions", "now.sql", "callback", "within", "objects.read", "integrity", "read.total"}
+
+func qualificationIndex(role, phase, stage string) (int, int, int) {
+	r, p, s := -1, -1, -1
+	for i, v := range qualificationRoles {
+		if v == role {
+			r = i
+			break
+		}
+	}
+	for i, v := range qualificationPhases {
+		if v == phase {
+			p = i
+			break
+		}
+	}
+	for i, v := range qualificationStages {
+		if v == stage {
+			s = i
+			break
+		}
+	}
+	return r, p, s
+}
+func (d *ContextClaimDiagnostics) BeginContentQualification(role, phase, stage string) {
+	if d == nil {
+		return
+	}
+	started := time.Now()
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	r, p, s := qualificationIndex(role, phase, stage)
+	if r < 0 || p < 0 || s < 0 {
+		d.qualificationDropped++
+		d.qualificationAmbiguous++
+	} else {
+		d.qualification[r][p][s].Attempted++
+	}
+	d.qualificationHookCalls++
+	d.qualificationHookElapsed += time.Since(started)
+}
+func (d *ContextClaimDiagnostics) EndContentQualification(role, phase, stage string, elapsed time.Duration, err error) {
+	if d == nil {
+		return
+	}
+	started := time.Now()
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	r, p, s := qualificationIndex(role, phase, stage)
+	if r < 0 || p < 0 || s < 0 {
+		d.qualificationDropped++
+		d.qualificationAmbiguous++
+	} else {
+		a := &d.qualification[r][p][s]
+		a.Completed++
+		a.Total += elapsed
+		if elapsed > a.Max {
+			a.Max = elapsed
+		}
+		if err != nil {
+			a.ErrorReturns++
+			if a.FirstCause == "" {
+				a.FirstCause = claimCause(err)
+			}
+		}
+	}
+	d.qualificationHookCalls++
+	d.qualificationHookElapsed += time.Since(started)
+}
