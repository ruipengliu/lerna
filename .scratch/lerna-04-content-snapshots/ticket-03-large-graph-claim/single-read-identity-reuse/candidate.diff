+// closureIdentityMemo retains only successful pure full-ref identities. Its
+// lifetime may span the two observations of one processing read, never another
+// read. Records, permissions, closure facts, and clocks are not stored here.
+type closureIdentityMemo map[v.ContentRef]string
+
+func (m closureIdentityMemo) identityID(ref v.ContentRef) (string, error) {
+	if id, ok := m[ref]; ok {
+		return id, nil
+	}
+	id, _, err := VersionIdentity(ref)
+	if err != nil {
+		return "", err
+	}
+	if len(m) < 65 {
+		m[ref] = id
+	}
+	return id, nil
+}
