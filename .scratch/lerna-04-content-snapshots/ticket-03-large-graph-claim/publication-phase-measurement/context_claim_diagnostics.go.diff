+type publicationDiagnosticStage struct {
+	Count                                    int
+	Total, Max                               time.Duration
+	FirstStart, FirstEnd, LastStart, LastEnd time.Duration
+	FirstErrorAt                             time.Duration
+	FirstError                               string
+}
+type publicationDiagnosticScope struct {
+	parent          *ContextClaimDiagnostics
+	role, ordinal   int
+	stages          [32]publicationDiagnosticStage
+	firstErrorStage string
+	firstErrorCause string
+	firstErrorAt    time.Duration
+}
+
+func (d *ContextClaimDiagnostics) publicationContext(ctx context.Context, role int) context.Context {
+	d.mu.Lock()
+	d.publicationCalls[role]++
+	ordinal := d.publicationCalls[role]
+	if ordinal > 2 {
+		d.publicationDropped++
+		d.mu.Unlock()
+		return ctx
+	}
+	scope := &d.publicationScopes[role*2+ordinal-1]
+	scope.parent, scope.role, scope.ordinal = d, role, ordinal
+	d.mu.Unlock()
+	return content.WithPublicationPhaseObserver(ctx, scope)
+}
+func (s *publicationDiagnosticScope) RecordPublicationPhase(stage string, start time.Time, err error) {
+	now := time.Now()
+	d := s.parent
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	index := -1
+	for i, name := range publicationDiagnosticStages {
+		if name == stage {
+			index = i
+			break
+		}
+	}
+	if index < 0 {
+		d.publicationDropped++
+		return
+	}
+	a := &s.stages[index]
+	duration := now.Sub(start)
+	a.Count++
+	a.Total += duration
+	if duration > a.Max {
+		a.Max = duration
+	}
+	if a.Count == 1 {
+		a.FirstStart, a.FirstEnd = start.Sub(d.start), now.Sub(d.start)
+	}
+	a.LastStart, a.LastEnd = start.Sub(d.start), now.Sub(d.start)
+	if err != nil && a.FirstError == "" {
+		a.FirstError, a.FirstErrorAt = claimCause(err), now.Sub(d.start)
+	}
+	if err != nil && s.firstErrorStage == "" {
+		s.firstErrorStage, s.firstErrorCause, s.firstErrorAt = stage, claimCause(err), now.Sub(d.start)
+	}
+}
