+// Called while summary already holds d.mu, after the original test finishes.
+func (d *ContextClaimDiagnostics) publicationSummary(t *testing.T) {
+	t.Logf("PUBLICATION_DIAG fixed_scopes=4 slots_per_scope=32 publish_calls=%d read_published_calls=%d dropped=%d monotonic_elapsed_only=true inclusive_totals_do_not_sum=true", d.publicationCalls[0], d.publicationCalls[1], d.publicationDropped)
+	for _, s := range d.publicationScopes {
+		if s.parent == nil {
+			continue
+		}
+		role, processingOwner := "worker.Publish", "publish_internal_verification"
+		if s.role == 1 {
+			role, processingOwner = "worker.ReadPublished", "outer_worker_read"
+		}
+		t.Logf("PUBLICATION_DIAG scope=%s ordinal=%d processing_owner=%s first_error_stage=%s first_error_at=%s cause=%s", role, s.ordinal, processingOwner, s.firstErrorStage, s.firstErrorAt, s.firstErrorCause)
+		for i, name := range publicationDiagnosticStages {
+			a := s.stages[i]
+			if a.Count == 0 {
+				continue
+			}
+			t.Logf("PUBLICATION_DIAG scope=%s ordinal=%d stage=%s count=%d inclusive_total=%s max=%s first_start=%s first_end=%s last_start=%s last_end=%s first_error_at=%s cause=%s", role, s.ordinal, name, a.Count, a.Total, a.Max, a.FirstStart, a.FirstEnd, a.LastStart, a.LastEnd, a.FirstErrorAt, a.FirstError)
+		}
+	}
