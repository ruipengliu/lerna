        "input": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/content"
        },
        "template_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "acceptance": {
          "$ref": "https://harness.invalid/protocol/v1/brain.schema.json#/$defs/acceptance"
        },
        "allowed_declarations": {
          "type": "array",
          "items": {
            "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/content"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "source_bindings": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/source_bindings"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "profile_version": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/seq"
        },
        "deadline": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/time"
        },
        "allocation": {
          "$ref": "https://harness.invalid/protocol/v1/task-control.schema.json#/$defs/budget_allocation"
        },
        "call_qualification": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/proof_ref"
        }
      },
      "required": [
        "task_id",
        "work_id",
        "attempt_no",
        "claim_epoch",
        "base_decision_revision",
        "owner_epoch",
        "input",
        "template_version",
        "acceptance",
        "allowed_declarations",
        "source_bindings",
        "profile_id",
        "profile_version",
        "deadline",
        "allocation",
        "call_qualification"
      ],
      "additionalProperties": false
    },
    "decide_response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "accepted"
            },
            "result": {
              "type": "object",
              "properties": {
                "task_id": {
                  "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
                },
                "work_id": {
                  "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
                },
                "attempt_no": {
                  "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uint"
                },
                "recorded": {
                  "const": true
                }
              },
              "required": [
                "task_id",
                "work_id",
                "attempt_no",
                "recorded"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "rejected"
            },
            "error": {
              "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/error"
            }
          },
          "required": [
            "status",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "observation": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "work_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "attempt_no": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uint"
        },
        "call_operation_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "producer_endpoint": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "call_revision": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/seq"
        },
        "state": {
          "enum": [
            "recorded",
            "generating",
            "returned",
            "rejected",
            "unknown",
            "stopped"
          ]
        },
        "physical_state": {
          "enum": [
            "not_started",
            "in_flight",
            "ended",
            "unknown"
          ]
        },
        "proposal": {
          "$ref": "https://harness.invalid/protocol/v1/brain.schema.json#/$defs/proposal"
        },
        "output": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/content"
        },
        "usage": {
          "type": "array",
          "items": {
            "$ref": "https://harness.invalid/protocol/v1/task-control.schema.json#/$defs/usage_item"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 0,
          "maxItems": 32
        },
        "stop_requested": {
          "type": "boolean"
        },
        "cancel_operations": {
          "type": "array",
          "items": {
            "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "context_requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "https://harness.invalid/protocol/v1/brain.schema.json#/$defs/context_requirement"
          }
        }
      },
      "required": [
        "task_id",
        "work_id",
        "attempt_no",
        "call_operation_id",
        "producer_endpoint",
        "call_revision",
        "state",
        "physical_state",
        "usage",
        "gaps",
        "stop_requested",
        "cancel_operations"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "proposal"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "const": "returned"
              }
            },
            "required": [
              "output"
            ]
          }
        },
        {
          "if": {
            "required": [
              "context_requirements"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "const": "returned"
              }
            },
            "required": [
              "output"
            ],
            "not": {
              "required": [
                "proposal"
              ]
            }
          }
        }
      ]
    },
    "observation_event": {
      "$ref": "https://harness.invalid/protocol/v1/brain.schema.json#/$defs/observation"
    },
    "query_request": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "call_operation_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        }
      },
      "required": [
        "task_id",
        "call_operation_id"
      ],
      "additionalProperties": false
    },
    "query_response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "completed"
            },
            "result": {
              "$ref": "https://harness.invalid/protocol/v1/brain.schema.json#/$defs/observation"
            }
          },
          "required": [
            "status",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "rejected"
            },
            "error": {
              "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/error"
            }
          },
          "required": [
            "status",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "cancel_request": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "call_operation_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "control_revision": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/seq"
        },
        "control_proof": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/proof_ref"
        }
      },
      "required": [
        "task_id",
        "call_operation_id",
        "control_revision",
        "control_proof"
      ],
      "additionalProperties": false
    },
    "cancel_response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "accepted"
            },
            "result": {
              "type": "object",
              "properties": {
                "task_id": {
                  "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
                },
                "call_operation_id": {
                  "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
                },
                "cancel_operation_id": {
                  "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
                },
                "recorded": {
                  "const": true
                }
              },
              "required": [
                "task_id",
                "call_operation_id",
                "cancel_operation_id",
                "recorded"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "rejected"
            },
            "error": {
              "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/error"
            }
          },
          "required": [
            "status",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "context_requirement": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "requirement_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "kind": {
              "const": "catalog_candidates"
            },
            "catalog_binding": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "continuation_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "requirement_id",
            "kind",
            "reason",
            "catalog_binding",
            "query"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "requirement_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "kind": {
              "const": "source_excerpt"
