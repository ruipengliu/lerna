            "capability_version": {
              "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uint"
            },
            "target_endpoint": {
              "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
            },
            "arguments": {
              "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/content"
            },
            "declaration_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/content"
              },
              "minItems": 0,
              "maxItems": 64
            },
            "maximum_cost": {
              "type": "array",
              "items": {
                "$ref": "https://harness.invalid/protocol/v1/task-control.schema.json#/$defs/budget_amount"
              },
              "minItems": 1,
              "maxItems": 16
