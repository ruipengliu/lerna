          "required": [
            "requirement_id",
            "kind",
            "reason",
            "content",
            "start_byte",
            "length_bytes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "requirement_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "reason": {
              "type": "string",
              "minLength": 1,
