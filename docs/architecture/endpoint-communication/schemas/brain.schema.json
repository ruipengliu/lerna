        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "delegate"
            },
            "action_key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "agent_endpoint": {
              "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
            },
            "agent_config_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "goal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            "constraints": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "minItems": 0,
              "maxItems": 32
            },
            "acceptance": {
              "$ref": "https://harness.invalid/protocol/v1/brain.schema.json#/$defs/acceptance"
            },
            "requested_scope": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "minItems": 1,
              "maxItems": 32
            },
            "maximum_cost": {
              "type": "array",
              "items": {
                "$ref": "https://harness.invalid/protocol/v1/task-control.schema.json#/$defs/budget_amount"
              },
              "minItems": 1,
              "maxItems": 16
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/content"
              },
              "minItems": 0,
              "maxItems": 64
            }
          },
          "required": [
            "kind",
            "action_key",
            "agent_endpoint",
            "agent_config_version",
            "goal",
            "constraints",
            "acceptance",
            "requested_scope",
            "maximum_cost",
            "evidence"
          ],
          "additionalProperties": false
        }
      ]
    },
    "blocker": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "input",
            "operation",
            "authorization",
            "budget",
            "capability",
            "time"
          ]
        },
        "object_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "required_fact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "wake_source": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "deadline": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/time"
        },
        "on_expiry": {
          "enum": [
            "redecide",
            "fail"
          ]
        }
      },
      "required": [
        "kind",
        "object_ref",
        "required_fact",
        "wake_source",
        "deadline",
        "on_expiry"
      ],
      "additionalProperties": false
    },
    "proposal": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "act"
            },
            "actions": {
              "type": "array",
              "items": {
                "$ref": "https://harness.invalid/protocol/v1/brain.schema.json#/$defs/action"
              },
              "minItems": 1,
              "maxItems": 32
            },
            "source_bindings": {
              "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/source_bindings"
            }
          },
          "required": [
            "kind",
            "actions",
            "source_bindings"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "wait"
            },
            "blockers": {
              "type": "array",
              "items": {
                "$ref": "https://harness.invalid/protocol/v1/brain.schema.json#/$defs/blocker"
              },
              "minItems": 1,
              "maxItems": 64
            },
            "inputs": {
              "type": "array",
              "items": {
                "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/input_request"
              },
              "minItems": 0,
              "maxItems": 64
            },
            "source_bindings": {
              "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/source_bindings"
            }
          },
          "required": [
            "kind",
            "blockers",
            "inputs",
            "source_bindings"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "finish"
            },
            "state": {
              "enum": [
                "completed",
                "failed"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "artifacts": {
              "type": "array",
              "items": {
                "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/content"
              },
              "minItems": 0,
              "maxItems": 64
            },
            "condition_evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "condition_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "condition_version": {
                    "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/seq"
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/content"
                    },
                    "minItems": 1,
                    "maxItems": 16
                  }
                },
                "required": [
                  "condition_id",
                  "condition_version",
                  "evidence"
                ],
                "additionalProperties": false
              },
              "minItems": 0,
              "maxItems": 64
            },
            "gaps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "minItems": 0,
              "maxItems": 32
            },
            "source_bindings": {
              "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/source_bindings"
            }
          },
          "required": [
            "kind",
            "state",
            "summary",
            "artifacts",
            "condition_evidence",
            "gaps",
            "source_bindings"
          ],
          "additionalProperties": false
        }
      ]
