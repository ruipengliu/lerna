        "conditions": {
          "type": "array",
          "items": {
            "$ref": "https://harness.invalid/protocol/v1/brain.schema.json#/$defs/condition"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "mode",
        "conditions",
        "gaps"
      ],
      "additionalProperties": false
