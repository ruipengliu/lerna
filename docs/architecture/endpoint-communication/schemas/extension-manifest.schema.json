{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.invalid/protocol/v1/extension-manifest.schema.json",
  "type": "object",
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"
    },
    "protocol_versions": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "maxLength": 192,
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*){2,}$"
          },
          "type_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "kinds": {
            "type": "array",
            "items": {
              "enum": [
                "request",
                "response",
                "event",
                "control"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "payload_schemas": {
            "type": "object",
            "properties": {
              "request": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "response": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "event": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "control": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "additionalProperties": false,
            "minProperties": 1
          },
          "delivery": {
            "enum": [
              "reliable",
              "ephemeral",
              "session"
            ]
          },
          "lane": {
            "enum": [
              "work",
              "control",
              "recovery",
              "session"
            ]
          },
          "authorization_scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 0,
            "maxItems": 64
          },
          "side_effecting": {
            "type": "boolean"
          },
          "operation_id": {
            "enum": [
              "required",
              "optional",
              "forbidden"
            ]
          },
          "recovery": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "scope_binding": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "task",
                  "operation",
                  "surface",
                  "authorization",
                  "catalog",
                  "memory",
                  "collection",
                  "content"
                ]
              },
              "field": {
                "type": "string",
                "pattern": "^(?:operation_id|target|payload\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*)$",
                "maxLength": 256
              }
            },
            "required": [
              "kind",
              "field"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "type",
          "type_version",
          "kinds",
          "payload_schemas",
          "delivery",
          "lane",
          "authorization_scopes",
          "side_effecting",
          "operation_id",
          "recovery"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "delivery": {
                  "const": "reliable"
                }
              }
            },
            "then": {
              "required": [
                "scope_binding"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "scope_binding"
                ]
              }
            }
          }
        ]
      },
      "minItems": 0,
      "maxItems": 1024
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 192,
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*){2,}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "version",
          "schema",
          "required"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 128
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "maxLength": 192,
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*){2,}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "fallback": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "maxLength": 192,
                "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*){2,}$"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            },
            "required": [
              "type",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "type",
          "version",
          "schema"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 128
    }
  },
  "required": [
    "manifest_version",
    "namespace",
    "protocol_versions",
    "messages",
    "extensions",
    "views"
  ],
  "additionalProperties": false
}
