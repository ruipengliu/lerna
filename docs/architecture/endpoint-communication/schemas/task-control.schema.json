        "source_bindings": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/source_bindings"
        },
        "validator_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "validator_version": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/seq"
        }
      },
      "required": [
        "task_id",
        "condition_id",
        "condition_version",
        "target_operation_id",
        "evidence",
        "source_bindings",
        "validator_id",
        "validator_version"
      ],
      "additionalProperties": false
    },
    "submit_evidence_response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "accepted"
            },
            "result": {
              "type": "object",
              "properties": {
                "task_id": {
                  "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
                },
                "evidence_operation_id": {
                  "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
                },
                "recorded": {
                  "const": true
                }
              },
              "required": [
                "task_id",
                "evidence_operation_id",
                "recorded"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "rejected"
            },
            "error": {
