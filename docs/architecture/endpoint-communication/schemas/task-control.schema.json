        },
        "condition_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "condition_version": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/seq"
        },
        "state": {
          "enum": [
            "verified",
            "invalid",
            "unavailable"
          ]
        },
        "verification": {
          "type": "array",
          "items": {
            "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/content"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "task_id",
        "evidence_operation_id",
        "condition_id",
        "condition_version",
        "state",
        "verification",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "verified"
              }
            }
          },
          "then": {
            "properties": {
              "verification": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
