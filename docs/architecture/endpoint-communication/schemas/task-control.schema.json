    "budget_snapshot": {
      "type": "object",
      "properties": {
        "revision": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/seq"
        },
        "amounts": {
          "type": "array",
          "items": {
            "$ref": "https://harness.invalid/protocol/v1/task-control.schema.json#/$defs/budget_amount"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "balances": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dimension": {
                "enum": [
                  "calls",
                  "tokens",
                  "bytes",
                  "duration_ms",
                  "cost"
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "target_settled": {
                "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uint64"
              },
              "target_reserved": {
                "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uint64"
              },
              "cleanup_settled": {
                "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uint64"
              },
