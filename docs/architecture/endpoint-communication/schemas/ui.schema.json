{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.invalid/protocol/v1/ui.schema.json",
  "$defs": {
    "document_view": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "blocks": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "type": {
                    "const": "text"
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 32768
                  }
                },
                "required": [
                  "id",
                  "type",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "type": {
                    "const": "markdown"
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 32768
                  }
                },
                "required": [
                  "id",
                  "type",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "type": {
                    "const": "content"
                  },
                  "content": {
                    "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/content"
                  },
                  "alt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "required": [
                  "id",
                  "type",
                  "content"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "type": {
                    "const": "form"
                  },
                  "input_request_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/field"
                    },
                    "minItems": 1,
                    "maxItems": 64
                  }
                },
                "required": [
                  "id",
                  "type",
                  "input_request_id",
                  "fields"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "type": {
                    "const": "actions"
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 64
                            },
                            "label": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "intent": {
                              "const": "submit_input"
                            },
                            "input_request_id": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                            }
                          },
                          "required": [
                            "id",
                            "label",
                            "intent",
                            "input_request_id"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 64
                            },
                            "label": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "intent": {
                              "const": "cancel_task"
                            },
                            "task_id": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                            }
                          },
                          "required": [
                            "id",
                            "label",
                            "intent",
                            "task_id"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 32
                  }
                },
                "required": [
                  "id",
                  "type",
                  "actions"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 0,
          "maxItems": 256
        }
      },
      "required": [
        "title",
        "blocks"
      ],
      "additionalProperties": false
    },
    "get_request": {
      "type": "object",
      "properties": {
        "surface_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "surface_id"
      ],
      "additionalProperties": false
    },
    "get_response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "completed"
            },
            "result": {
              "type": "object",
              "properties": {
                "surface_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "revision": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,19}$",
                  "format": "harness-uint64"
                },
                "task_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "final": {
                  "type": "boolean"
                },
                "view": {
                  "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/view"
                },
                "input_requests": {
                  "type": "array",
                  "items": {
                    "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/input_request"
                  },
                  "minItems": 0,
                  "maxItems": 64
                },
                "presentation": {
                  "$ref": "#/$defs/presentation"
                }
              },
              "required": [
                "surface_id",
                "revision",
                "final",
                "view",
                "input_requests",
                "presentation"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "rejected"
            },
            "error": {
              "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/error"
            }
          },
          "required": [
            "status",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "snapshot_event": {
      "type": "object",
      "properties": {
        "surface_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "format": "harness-uint64"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "final": {
          "type": "boolean"
        },
        "view": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/view"
        },
        "input_requests": {
          "type": "array",
          "items": {
            "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/input_request"
          },
          "minItems": 0,
          "maxItems": 64
        }
      },
      "required": [
        "surface_id",
        "revision",
        "final",
        "view",
        "input_requests"
      ],
      "additionalProperties": false
    },
    "delta_event": {
      "type": "object",
      "properties": {
        "surface_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "base_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "format": "harness-uint64"
        },
        "revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "format": "harness-uint64"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "block_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "append_text": {
                "type": "string",
                "maxLength": 8192
              }
            },
            "required": [
              "block_id",
              "append_text"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 64
        }
      },
      "required": [
        "surface_id",
        "base_revision",
        "revision",
        "changes"
      ],
      "additionalProperties": false
    },
    "input_requested_event": {
      "type": "object",
      "properties": {
        "surface_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "input": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/input_request"
        }
      },
      "required": [
        "surface_id",
        "input"
      ],
      "additionalProperties": false
    },
    "input_request": {
      "type": "object",
      "properties": {
        "surface_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "seen_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "format": "harness-uint64"
        },
        "input_request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "values": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/values"
        },
        "preview_receipt": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/preview_receipt"
        }
      },
      "required": [
        "surface_id",
        "seen_revision",
        "input_request_id",
        "values"
      ],
      "additionalProperties": false
    },
    "input_response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "accepted"
            },
            "result": {
              "type": "object",
              "properties": {
                "input_request_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "recorded": {
                  "const": true
                }
              },
              "required": [
                "input_request_id",
                "recorded"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "rejected"
            },
            "error": {
              "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/error"
            }
          },
          "required": [
            "status",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "action_request": {
      "type": "object",
      "properties": {
        "surface_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "seen_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "format": "harness-uint64"
        },
        "action_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "surface_id",
        "seen_revision",
        "action_id"
      ],
      "additionalProperties": false
    },
    "action_response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "accepted"
            },
            "result": {
              "type": "object",
              "properties": {
                "recorded": {
                  "const": true
                }
              },
              "required": [
                "recorded"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "rejected"
            },
            "error": {
              "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/error"
            }
          },
          "required": [
            "status",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "input_result_event": {
      "type": "object",
      "properties": {
        "surface_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "input_request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "status": {
          "enum": [
            "applied",
            "rejected",
            "conflict"
          ]
        },
        "error": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/error"
        }
      },
      "required": [
        "surface_id",
        "input_request_id",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "rejected",
                  "conflict"
                ]
              }
            }
          },
          "then": {
            "required": [
              "error"
            ]
          },
          "else": {
            "not": {
              "required": [
                "error"
              ]
            }
          }
        }
      ]
    },
    "action_result_event": {
      "type": "object",
      "properties": {
        "surface_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "status": {
          "enum": [
            "applied",
            "rejected",
            "conflict"
          ]
        },
        "error": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/error"
        }
      },
      "required": [
        "surface_id",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "rejected",
                  "conflict"
                ]
              }
            }
          },
          "then": {
            "required": [
              "error"
            ]
          },
          "else": {
            "not": {
              "required": [
                "error"
              ]
            }
          }
        }
      ]
    },
    "query_operation_request": {
      "type": "object",
      "properties": {
        "target_operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "target_operation_id"
      ],
      "additionalProperties": false
    },
    "query_operation_response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "completed"
            },
            "result": {
              "type": "object",
              "properties": {
                "target_operation_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "state": {
                  "enum": [
                    "recorded",
                    "applied",
                    "rejected",
                    "conflict"
                  ]
                },
                "input_request_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "task_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "error": {
                  "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/error"
                }
              },
              "required": [
                "target_operation_id",
                "state"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "rejected"
            },
            "error": {
              "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/error"
            }
          },
          "required": [
            "status",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "presentation": {
      "type": "object",
      "properties": {
        "revision": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uint64"
        },
        "state": {
          "enum": [
            "open",
            "closed"
          ]
        }
      },
      "required": [
        "revision",
        "state"
      ],
      "additionalProperties": false
    },
    "set_presentation_request": {
      "type": "object",
      "properties": {
        "surface_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "expected_revision": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uint64"
        },
        "state": {
          "enum": [
            "open",
            "closed"
          ]
        }
      },
      "required": [
        "surface_id",
        "expected_revision",
        "state"
      ],
      "additionalProperties": false
    },
    "set_presentation_response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "completed"
            },
            "result": {
              "type": "object",
              "properties": {
                "surface_id": {
                  "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
                },
                "revision": {
                  "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uint64"
                },
                "state": {
                  "enum": [
                    "open",
                    "closed"
                  ]
                }
              },
              "required": [
                "surface_id",
                "revision",
                "state"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "rejected"
            },
            "error": {
              "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/error"
            }
          },
          "required": [
            "status",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
