          "then": {
            "required": [
              "consumed_by",
              "consumed_at"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "consumed_by"
                  ]
                },
                {
                  "required": [
                    "consumed_at"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "approved",
                  "denied",
                  "consumed"
                ]
              }
            }
          },
