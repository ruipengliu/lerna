  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
    },
    "Revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "Count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "Decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,9})?$"
    },
    "Amount": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "value": {
          "$ref": "#/$defs/Decimal"
        }
      },
      "required": [
        "unit",
        "value"
      ],
      "additionalProperties": false
    },
    "ObjectRef": {
      "type": "object",
      "properties": {
        "owner_id": {
          "$ref": "#/$defs/Id"
        },
        "object_id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "owner_id",
        "object_id",
        "revision"
      ],
      "additionalProperties": false
    },
    "ComponentRef": {
      "type": "object",
      "properties": {
        "component_id": {
          "$ref": "#/$defs/Id"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "component_id",
        "version",
        "digest"
      ],
      "additionalProperties": false
    },
    "ContentRef": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "owner_id": {
          "$ref": "#/$defs/Id"
        },
        "content_id": {
          "$ref": "#/$defs/Id"
        },
        "version": {
          "$ref": "#/$defs/Revision"
        },
        "hash": {
          "$ref": "#/$defs/Digest"
        },
        "media_type": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.+-]+/[A-Za-z0-9.+-]+$"
        },
        "byte_length": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "tenant_id",
        "owner_id",
        "content_id",
        "version",
        "hash",
        "media_type",
        "byte_length"
      ],
      "additionalProperties": false
    },
    "CollectionSummary": {
      "type": "object",
      "properties": {
        "collection_revision": {
          "$ref": "#/$defs/Revision"
        },
        "total_count": {
          "$ref": "#/$defs/Count"
        },
        "unresolved_count": {
          "$ref": "#/$defs/Count"
        },
        "items_cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "complete": {
          "type": "boolean"
        }
      },
      "required": [
        "collection_revision",
        "total_count",
        "unresolved_count",
        "complete"
      ],
      "additionalProperties": false
    },
    "BudgetBalance": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "limit": {
          "$ref": "#/$defs/Decimal"
        },
        "reserved": {
          "$ref": "#/$defs/Decimal"
        },
        "spent": {
          "$ref": "#/$defs/Decimal"
        }
      },
      "required": [
        "unit",
        "limit",
        "reserved",
        "spent"
      ],
      "additionalProperties": false
    },
    "Requirement": {
      "type": "object",
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "enum": [
            "effect",
            "quality"
          ]
        },
        "source_ref": {
          "$ref": "#/$defs/ContentRef"
        },
        "rule_ref": {
          "$ref": "#/$defs/ComponentRef"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "requirement_id",
        "kind",
        "source_ref",
        "rule_ref",
        "required"
      ],
      "additionalProperties": false
    },
    "WaitReason": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "input",
            "authorization",
            "dependency",
            "budget",
            "effect",
            "capacity",
            "evidence"
          ]
        },
        "object_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "resume_condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "next_check_at": {
          "$ref": "#/$defs/Time"
        }
      },
      "required": [
        "kind",
        "resume_condition"
      ],
      "additionalProperties": false
    },
    "Task": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/Id"
        },
        "task_id": {
          "$ref": "#/$defs/Id"
        },
        "orchestrator_id": {
          "$ref": "#/$defs/Id"
        },
        "submit_command_id": {
          "$ref": "#/$defs/Id"
        },
        "goal_ref": {
          "$ref": "#/$defs/ContentRef"
        },
        "goal_revision": {
          "$ref": "#/$defs/Revision"
        },
        "control_revision": {
          "$ref": "#/$defs/Revision"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "policy_ref": {
          "$ref": "#/$defs/ComponentRef"
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Requirement"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "deadline": {
          "$ref": "#/$defs/Time"
        },
        "status": {
          "enum": [
            "active",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "control": {
          "enum": [
            "running",
            "paused"
          ]
        },
        "wait_reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WaitReason"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "budget": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BudgetBalance"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "open_effects": {
          "$ref": "#/$defs/CollectionSummary"
        },
        "accounting_open": {
          "type": "boolean"
        },
        "result_ref": {
          "$ref": "#/$defs/ContentRef"
        },
        "acceptance_ref": {
          "$ref": "#/$defs/ObjectRef"
        }
      },
      "required": [
        "tenant_id",
        "task_id",
        "orchestrator_id",
        "submit_command_id",
        "goal_ref",
        "goal_revision",
        "control_revision",
        "revision",
        "policy_ref",
        "requirements",
        "deadline",
        "status",
        "control",
        "wait_reasons",
        "budget",
        "open_effects",
        "accounting_open"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "required": [
              "result_ref"
            ],
            "properties": {
              "open_effects": {
                "properties": {
                  "unresolved_count": {
                    "const": 0
                  },
                  "complete": {
                    "const": true
                  }
                }
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "result_ref"
              ]
            }
          }
        }
      ]
    },
    "Operation": {
      "type": "object",
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/Id"
        },
        "owner_id": {
          "$ref": "#/$defs/Id"
        },
        "task_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "execution_state": {
          "enum": [
            "accepted",
            "started",
            "closed"
          ]
        },
        "effect": {
          "enum": [
            "not_started",
            "applied",
            "not_applied",
            "unknown"
          ]
        },
        "may_apply_later": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "const": "unknown"
            }
          ]
        },
        "attempts": {
          "$ref": "#/$defs/CollectionSummary"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentRef"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "result_ref": {
          "$ref": "#/$defs/ContentRef"
        },
        "usage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Amount"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "usage_final": {
          "type": "boolean"
        },
        "next_action": {
          "enum": [
            "query_original",
            "provide_authorization",
            "provide_evidence",
            "wait",
            "none"
          ]
        }
      },
      "required": [
        "operation_id",
        "owner_id",
        "task_ref",
        "revision",
        "execution_state",
        "effect",
        "may_apply_later",
        "attempts",
        "evidence_refs",
        "usage",
        "usage_final",
        "next_action"
      ],
      "additionalProperties": false
    },
    "ConditionResult": {
      "type": "object",
      "properties": {
        "check_id": {
          "$ref": "#/$defs/Id"
        },
        "task_id": {
          "$ref": "#/$defs/Id"
        },
        "goal_revision": {
          "$ref": "#/$defs/Revision"
        },
        "requirement_id": {
          "$ref": "#/$defs/Id"
        },
        "artifact_ref": {
          "$ref": "#/$defs/ContentRef"
        },
        "rule_ref": {
          "$ref": "#/$defs/ComponentRef"
        },
        "evaluator_ref": {
          "$ref": "#/$defs/ComponentRef"
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "applicability": {
          "enum": [
            "usable",
            "unknown",
            "inapplicable"
          ]
        },
        "basis": {
          "enum": [
            "verified",
            "assessed",
            "user_accepted"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentRef"
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "check_id",
        "task_id",
        "goal_revision",
        "requirement_id",
        "artifact_ref",
        "rule_ref",
        "evaluator_ref",
        "verdict",
        "applicability",
        "basis",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "Result": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "#/$defs/Id"
        },
        "goal_revision": {
          "$ref": "#/$defs/Revision"
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentRef"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "completion_basis": {
          "enum": [
            "verified",
            "assessed",
            "user_accepted"
          ]
        },
        "condition_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConditionResult"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "coverage_ref": {
          "$ref": "#/$defs/ContentRef"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 0,
          "maxItems": 100
        },
        "completed_at": {
          "$ref": "#/$defs/Time"
        }
      },
      "required": [
        "task_id",
        "goal_revision",
        "artifact_refs",
        "completion_basis",
        "condition_results",
        "coverage_ref",
        "limitations",
        "completed_at"
      ],
      "additionalProperties": false
    },
    "DecisionDispatchIntent": {
      "type": "object",
      "properties": {
        "decision_id": {
          "$ref": "#/$defs/Id"
        },
        "task_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "snapshot_ref": {
          "$ref": "#/$defs/ContentRef"
        },
        "snapshot_revision": {
          "$ref": "#/$defs/Revision"
        },
        "model_profile_ref": {
          "$ref": "#/$defs/ComponentRef"
        },
        "brain_owner_id": {
          "$ref": "#/$defs/Id"
        },
        "command_id": {
          "$ref": "#/$defs/Id"
        },
        "intent_hash": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "decision_id",
        "task_ref",
        "snapshot_ref",
        "snapshot_revision",
        "model_profile_ref",
        "brain_owner_id",
        "command_id",
        "intent_hash"
      ],
      "additionalProperties": false
    },
    "DecisionRecord": {
      "type": "object",
      "properties": {
        "decision_id": {
          "$ref": "#/$defs/Id"
        },
        "owner_id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "snapshot_revision": {
          "$ref": "#/$defs/Revision"
        },
        "status": {
          "enum": [
            "accepted",
            "running",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "send_started": {
          "type": "boolean"
        },
        "physical_request_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "proposal_ref": {
          "$ref": "#/$defs/ContentRef"
        },
        "usage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Amount"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "usage_final": {
          "type": "boolean"
        }
      },
      "required": [
        "decision_id",
        "owner_id",
        "revision",
        "snapshot_revision",
        "status",
        "send_started",
        "physical_request_count",
        "usage",
        "usage_final"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "required": [
              "proposal_ref"
            ]
          },
          "else": {
            "not": {
              "required": [
                "proposal_ref"
              ]
            }
          }
        }
      ]
    },
    "Grant": {
      "type": "object",
      "properties": {
        "grant_id": {
          "$ref": "#/$defs/Id"
        },
        "owner_id": {
          "$ref": "#/$defs/Id"
        },
