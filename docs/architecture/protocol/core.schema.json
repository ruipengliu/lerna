          },
          "record_type": {
            "const": "Grant"
          },
          "record": {
            "$ref": "#/$defs/Grant"
          }
        },
        "required": [
          "case_id",
          "record_type",
          "record"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
