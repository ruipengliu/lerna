      },
      {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "record_type": {
            "const": "ConditionResult"
          },
          "record": {
            "$ref": "#/$defs/ConditionResult"
          }
        },
        "required": [
          "case_id",
