{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task outcome verification fixture — a projection, not the complete wire protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "result",
    "operations",
    "accounting_open"
  ],
  "properties": {
    "task": {
      "type": "object",
      "required": [
        "task_id",
        "goal_revision",
        "status",
        "required_requirement_ids",
        "tenant_id"
      ],
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "goal_revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "active",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "required_requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "result": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/result"
        }
      ]
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "accounting_open": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "owner_id",
        "content_id",
        "version",
        "hash",
        "media_type",
        "byte_length"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_id": {
          "type": "string",
          "minLength": 1
        },
        "content_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "version",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "goal_revision",
        "artifact_ref",
        "verdict",
        "basis",
        "evidence_refs",
        "evaluator_ref"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "goal_revision": {
          "type": "integer",
          "minimum": 1
        },
        "artifact_ref": {
          "$ref": "#/$defs/content"
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "basis": {
          "enum": [
            "verified",
            "assessed",
            "user_accepted"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/content"
          }
        },
        "evaluator_ref": {
          "$ref": "#/$defs/component"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "goal_revision",
        "artifact_refs",
        "completion_basis",
        "condition_results",
        "limitations",
        "completed_at"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "goal_revision": {
          "type": "integer",
          "minimum": 1
        },
        "artifact_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/content"
          }
        },
        "completion_basis": {
          "enum": [
            "verified",
            "assessed",
            "user_accepted"
          ]
        },
        "condition_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "operation": {
      "type": "object",
      "required": [
        "operation_id",
        "execution_state",
        "effect",
        "may_apply_later"
      ],
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "execution_state": {
          "enum": [
            "accepted",
            "started",
            "closed"
          ]
        },
        "effect": {
          "enum": [
            "not_started",
            "applied",
            "not_applied",
            "unknown"
          ]
        },
        "may_apply_later": {
          "enum": [
            true,
            false,
            "unknown"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/result"
          },
          "operations": {
            "items": {
              "properties": {
                "execution_state": {
                  "const": "closed"
                },
                "effect": {
                  "enum": [
                    "applied",
                    "not_applied"
                  ]
                },
                "may_apply_later": {
                  "const": false
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "result": {
            "type": "null"
          }
        }
      }
    }
  ]
}
