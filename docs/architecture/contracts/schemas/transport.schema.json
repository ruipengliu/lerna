{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.invalid/schema/transport-draft-2",
  "$defs": {
    "Discovery": {
      "type": "object",
      "properties": {
        "logical_service_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
        },
        "protocol": {
          "const": "harness/1"
        },
        "profile": {
          "const": "full-harness-draft-2"
        },
        "schema_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "methods_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 256
        },
        "auth_profile": {
          "const": "opaque-bearer-1"
        },
        "proof_profile": {
          "const": "home-jws-es256-1"
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_json_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 262144
            },
            "max_page_items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "max_pull_items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "max_wait_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 25000
            },
            "max_content_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "max_json_bytes",
            "max_page_items",
            "max_pull_items",
            "max_wait_ms",
            "max_content_bytes"
          ],
          "additionalProperties": false
        },
        "retention": {
          "type": "object",
          "properties": {
            "receipt_query_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "minimal_closed_identity": {
              "const": "permanent"
            }
          },
          "required": [
            "receipt_query_seconds",
            "minimal_closed_identity"
          ],
          "additionalProperties": false
        },
        "changes_supported": {
          "type": "boolean"
        }
      },
      "required": [
        "logical_service_id",
        "protocol",
        "profile",
        "schema_digest",
        "methods_digest",
        "methods",
        "auth_profile",
        "proof_profile",
        "limits",
        "retention",
        "changes_supported"
      ],
      "additionalProperties": false
    },
    "DiscoveryPublic": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "harness/1"
        },
        "auth_profile": {
          "const": "opaque-bearer-1"
        },
        "pairing_supported": {
          "type": "boolean"
        }
      },
      "required": [
        "protocol",
        "auth_profile",
        "pairing_supported"
      ],
      "additionalProperties": false
    },
    "PullInput": {
      "type": "object",
      "properties": {
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "wait_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25000
        }
      },
      "required": [
        "max_items",
        "wait_ms"
      ],
      "additionalProperties": false
    },
    "Lookup": {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
        }
      },
      "required": [
        "command_id"
      ],
      "additionalProperties": false
    },
    "Delivery": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "delivery_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
            },
            "sender_service_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
            },
            "recipient_endpoint_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
            },
            "recipient_instance_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
            },
            "request_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "kind": {
              "const": "command"
            },
            "request": {
              "$ref": "protocol.schema.json#/$defs/Command"
            },
            "deliver_before": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            }
          },
          "required": [
            "delivery_id",
            "sender_service_id",
            "recipient_endpoint_id",
            "recipient_instance_id",
            "request_digest",
            "kind",
            "request",
            "deliver_before"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "delivery_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
            },
            "sender_service_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
            },
            "recipient_endpoint_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
            },
            "recipient_instance_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
            },
            "request_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "kind": {
              "const": "query"
            },
            "request": {
              "$ref": "protocol.schema.json#/$defs/Query"
            },
            "deliver_before": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            }
          },
          "required": [
            "delivery_id",
            "sender_service_id",
            "recipient_endpoint_id",
            "recipient_instance_id",
            "request_digest",
            "kind",
            "request",
            "deliver_before"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "delivery_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
            },
            "sender_service_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
            },
            "recipient_endpoint_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
            },
            "recipient_instance_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
            },
            "request_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "kind": {
              "const": "receipt_lookup"
            },
            "request": {
              "$ref": "#/$defs/Lookup"
            },
            "deliver_before": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            }
          },
          "required": [
            "delivery_id",
            "sender_service_id",
            "recipient_endpoint_id",
            "recipient_instance_id",
            "request_digest",
            "kind",
            "request",
            "deliver_before"
          ],
          "additionalProperties": false
        }
      ]
    },
    "DeliveryEnvelope": {
      "type": "object",
      "properties": {
        "delivery": {
          "$ref": "#/$defs/Delivery"
        },
        "delivery_proof": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
          "maxLength": 65536
        }
      },
      "required": [
        "delivery",
        "delivery_proof"
      ],
      "additionalProperties": false
    },
    "PullOutput": {
      "type": "object",
      "properties": {
        "deliveries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeliveryEnvelope"
          },
          "maxItems": 100
        },
        "more": {
          "type": "boolean"
        },
        "mirror_uploads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MirrorTicket"
          },
          "maxItems": 100
        }
      },
      "required": [
        "deliveries",
        "more"
      ],
      "additionalProperties": false
    },
    "Reply": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "delivery_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
            },
            "request_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "kind": {
              "const": "command"
            },
            "result": {
              "oneOf": [
                {
                  "$ref": "protocol.schema.json#/$defs/Receipt"
                },
                {
                  "$ref": "#/$defs/ErrorResult"
                }
              ]
            },
            "withheld": {
              "const": true
            }
          },
          "required": [
            "delivery_id",
            "request_digest",
            "kind",
            "result"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "required": [
                  "withheld"
                ]
              },
              "then": {
                "properties": {
                  "result": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/ErrorResult"
                      },
                      {
                        "properties": {
                          "error": {
                            "properties": {
                              "code": {
                                "const": "forbidden"
                              },
                              "retry": {
                                "const": "after_change"
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "delivery_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
            },
            "request_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "kind": {
              "const": "query"
            },
            "result": {
              "oneOf": [
                {
                  "$ref": "protocol.schema.json#/$defs/QueryResult"
                },
                {
                  "$ref": "#/$defs/ErrorResult"
                }
              ]
            },
            "withheld": {
              "const": true
            }
          },
          "required": [
            "delivery_id",
            "request_digest",
            "kind",
            "result"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "required": [
                  "withheld"
                ]
              },
              "then": {
                "properties": {
                  "result": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/ErrorResult"
                      },
                      {
                        "properties": {
                          "error": {
                            "properties": {
                              "code": {
                                "const": "forbidden"
                              },
                              "retry": {
                                "const": "after_change"
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "delivery_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
            },
            "request_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "kind": {
              "const": "receipt_lookup"
            },
            "result": {
              "oneOf": [
                {
                  "$ref": "protocol.schema.json#/$defs/Receipt"
                },
                {
                  "$ref": "#/$defs/ErrorResult"
                }
              ]
            },
            "withheld": {
              "const": true
            }
          },
          "required": [
            "delivery_id",
            "request_digest",
            "kind",
            "result"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "required": [
                  "withheld"
                ]
              },
              "then": {
                "properties": {
                  "result": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/ErrorResult"
                      },
                      {
                        "properties": {
                          "error": {
                            "properties": {
                              "code": {
                                "const": "forbidden"
                              },
                              "retry": {
                                "const": "after_change"
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "ReplyAck": {
      "type": "object",
      "properties": {
        "delivery_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
        },
        "stored": {
          "const": true
        },
        "result_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "delivery_id",
        "stored",
        "result_digest"
      ],
      "additionalProperties": false
    },
    "ControlProofPayload": {
      "type": "object",
      "properties": {
        "issuer": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
        },
        "audience": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
        },
        "gate": {
          "$ref": "protocol.schema.json#/$defs/TaskGate"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "start_before": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "issuer",
        "tenant_id",
        "audience",
        "gate",
        "issued_at",
        "start_before"
      ],
      "additionalProperties": false
    },
    "UploadIntent": {
      "type": "object",
      "properties": {
        "upload_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "upload_id",
        "hash",
        "byte_length",
        "media_type",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "Upload": {
      "type": "object",
      "properties": {
        "upload_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "state": {
          "enum": [
            "reserved",
            "ready",
            "committed",
            "expired"
          ]
        },
        "content_ref": {
          "$ref": "protocol.schema.json#/$defs/ContentRef"
        }
      },
      "required": [
        "upload_id",
        "hash",
        "byte_length",
        "media_type",
        "expires_at",
        "state"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "committed"
              }
            }
          },
          "then": {
            "required": [
              "content_ref"
            ]
          },
          "else": {
            "not": {
              "required": [
                "content_ref"
              ]
            }
          }
        }
      ]
    },
    "Change": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "object_type": {
          "enum": [
            "task",
            "operation",
            "memory",
            "surface",
            "activation",
            "grant"
          ]
        },
        "object_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "cursor",
        "object_type",
        "object_id",
        "revision"
      ],
      "additionalProperties": false
    },
    "ClosedIdentity": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
        },
        "owner_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
        },
        "object_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
        },
        "kind": {
          "enum": [
            "command",
            "operation",
            "task"
          ]
        },
        "closed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "outcome": {
          "enum": [
            "applied",
            "rejected",
            "cancelled",
            "succeeded",
            "failed"
          ]
        },
        "payload_retained": {
          "type": "boolean"
        }
      },
      "required": [
        "tenant_id",
        "owner_id",
        "object_id",
        "kind",
        "closed_at",
        "outcome",
        "payload_retained"
      ],
      "additionalProperties": false
    },
    "ClosedIdentityLookup": {
      "type": "object",
      "properties": {
        "record": {
          "$ref": "#/$defs/ClosedIdentity"
        },
        "lookup_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "response_code": {
          "enum": [
            "gone",
            "idempotency_conflict",
            "precondition_failed"
          ]
        }
      },
      "required": [
        "record",
        "lookup_id",
        "response_code"
      ],
      "additionalProperties": false
    },
    "ErrorResult": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "protocol.schema.json#/$defs/Error"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "MirrorTicket": {
      "type": "object",
      "properties": {
        "ticket_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
        },
        "upload_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
        },
        "receiver_service_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
        },
        "sender_endpoint_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
        },
        "sender_instance_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
        },
        "content_ref": {
          "$ref": "protocol.schema.json#/$defs/ContentRef"
        },
        "copy_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*_[0-9a-f]{32}$"
        },
        "source_control_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "ticket_id",
        "upload_id",
        "receiver_service_id",
        "sender_endpoint_id",
        "sender_instance_id",
        "content_ref",
        "copy_id",
        "source_control_revision",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "Mirror": {
      "type": "object",
      "properties": {
        "ticket": {
          "$ref": "#/$defs/MirrorTicket"
        },
        "state": {
          "enum": [
            "reserved",
            "ready",
            "closed",
            "expired"
          ]
        },
        "cleanup_state": {
          "enum": [
            "pending",
            "complete",
            "residual",
            "unknown"
          ]
        },
        "retention_until": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "control_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "ticket",
        "state",
        "cleanup_state",
        "retention_until",
        "control_revision"
      ],
      "additionalProperties": false
    },
    "MirrorRead": {
      "type": "object",
      "properties": {
        "mirror": {
          "$ref": "#/$defs/Mirror"
        },
        "source_download": {
          "$ref": "protocol.schema.json#/$defs/ContentGetOutput"
        },
        "observed_at": {
