{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.invalid/schema/brain-generation-1",
  "description": "Brain 内部模型输出；局部引用必须保存并回填为准确 ContentRef 后才按公共 Proposal 校验。不是领域 RPC 消息。",
  "type": "object",
  "properties": {
    "schema_version": { "const": "brain-generation/1" },
    "contents": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "local_id": { "$ref": "#/$defs/LocalId" },
          "media_type": { "enum": ["text/plain", "text/markdown", "application/json"] },
          "body": { "$ref": "#/$defs/Node" }
        },
        "required": ["local_id", "media_type", "body"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "media_type": { "const": "application/json" } } },
            "then": { "properties": { "body": { "$ref": "#/$defs/Object" } } },
            "else": { "properties": { "body": { "type": "string", "maxLength": 131072 } } }
          }
        ]
      }
    },
    "proposal": { "$ref": "#/$defs/Object" }
  },
  "required": ["schema_version", "contents", "proposal"],
  "additionalProperties": false,
  "$defs": {
    "LocalId": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "LocalRef": {
      "type": "object",
      "properties": { "$local_ref": { "$ref": "#/$defs/LocalId" } },
      "required": ["$local_ref"],
      "additionalProperties": false
    },
    "Object": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": { "not": { "const": "$local_ref" } },
      "additionalProperties": { "$ref": "#/$defs/Node" }
    },
    "Node": {
      "oneOf": [
        { "$ref": "#/$defs/LocalRef" },
        { "$ref": "#/$defs/Object" },
        { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/Node" } },
        { "type": "string", "maxLength": 131072 },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    }
  }
}
