{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.invalid/protocol/v1/task.schema.json",
  "$defs": {
    "submit_request": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/content"
          },
          "minItems": 0,
          "maxItems": 64
        }
      },
      "required": [
        "task_id",
        "goal"
      ],
      "additionalProperties": false
    },
    "submit_response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "accepted"
            },
            "result": {
              "type": "object",
              "properties": {
                "task_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                }
              },
              "required": [
                "task_id"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "rejected"
            },
            "error": {
              "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/error"
            }
          },
          "required": [
            "status",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "query_request": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "task_id"
      ],
      "additionalProperties": false
    },
    "query_response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "completed"
            },
            "result": {
              "type": "object",
              "properties": {
                "task_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "revision": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,19}$",
                  "format": "harness-uint64"
                },
                "state": {
                  "enum": [
                    "queued",
                    "running",
                    "waiting_input",
                    "waiting_dependency",
                    "cancelling",
                    "completed",
                    "failed",
                    "cancelled"
                  ]
                },
                "effects_pending": {
                  "type": "boolean"
                },
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "input_requests": {
                  "type": "array",
                  "items": {
                    "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/input_request"
                  },
                  "minItems": 0,
                  "maxItems": 64
                },
                "control": {
                  "$ref": "https://harness.invalid/protocol/v1/task-control.schema.json#/$defs/control"
                },
                "budget": {
                  "$ref": "https://harness.invalid/protocol/v1/task-control.schema.json#/$defs/budget_snapshot"
                }
              },
              "required": [
                "task_id",
                "revision",
                "state",
                "effects_pending",
                "control",
                "budget"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "rejected"
            },
            "error": {
              "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/error"
            }
          },
          "required": [
            "status",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "query_operation_request": {
      "type": "object",
      "properties": {
        "target_operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "target_operation_id"
      ],
      "additionalProperties": false
    },
    "query_operation_response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "completed"
            },
            "result": {
              "type": "object",
              "properties": {
                "target_operation_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "task_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "state": {
                  "enum": [
                    "recorded",
                    "applied",
                    "rejected"
                  ]
                },
                "error": {
                  "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/error"
                },
                "control_result": {
                  "$ref": "https://harness.invalid/protocol/v1/task-control.schema.json#/$defs/control_receipt"
                }
              },
              "required": [
                "target_operation_id",
                "task_id",
                "state"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "rejected"
            },
            "error": {
              "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/error"
            }
          },
          "required": [
            "status",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "input_request": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "input_request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "values": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/values"
        },
        "preview_receipt": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/preview_receipt"
        }
      },
      "required": [
        "task_id",
        "input_request_id",
        "values"
      ],
      "additionalProperties": false
    },
    "input_response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "completed"
            },
            "result": {
              "type": "object",
              "properties": {
                "task_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "input_request_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "consumed": {
                  "const": true
                }
              },
              "required": [
                "task_id",
                "input_request_id",
                "consumed"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "rejected"
            },
            "error": {
              "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/error"
            }
          },
          "required": [
            "status",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "cancel_request": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "task_id"
      ],
      "additionalProperties": false
    },
    "cancel_response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "accepted"
            },
            "result": {
              "type": "object",
              "properties": {
                "task_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "cancel_requested": {
                  "const": true
                }
              },
              "required": [
                "task_id",
                "cancel_requested"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "rejected"
            },
            "error": {
              "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/error"
            }
          },
          "required": [
            "status",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "status_event": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "format": "harness-uint64"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "waiting_input",
            "waiting_dependency",
            "cancelling",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "effects_pending": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "input_requests": {
          "type": "array",
          "items": {
            "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/input_request"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "control": {
          "$ref": "https://harness.invalid/protocol/v1/task-control.schema.json#/$defs/control"
        },
        "budget": {
          "$ref": "https://harness.invalid/protocol/v1/task-control.schema.json#/$defs/budget_snapshot"
        }
      },
      "required": [
        "task_id",
        "revision",
        "state",
        "effects_pending",
        "control",
        "budget"
      ],
      "additionalProperties": false
    },
    "input_requested_event": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "input": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/input_request"
        }
      },
      "required": [
        "task_id",
        "input"
      ],
      "additionalProperties": false
    },
    "result_event": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "format": "harness-uint64"
        },
        "state": {
          "enum": [
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "effects_pending": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/content"
          },
          "minItems": 0,
          "maxItems": 64
        }
      },
      "required": [
        "task_id",
        "revision",
        "state",
        "effects_pending",
        "summary"
      ],
      "additionalProperties": false
    },
    "cancel_result_event": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "state": {
          "enum": [
            "stopped",
            "already_finished",
            "effects_unknown"
          ]
        },
        "effects_pending": {
          "type": "boolean"
        }
      },
      "required": [
        "task_id",
        "state",
        "effects_pending"
      ],
      "additionalProperties": false
    },
    "query_result_request": {
      "$ref": "#/$defs/query_request"
    },
    "query_result_response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "completed"
            },
            "result": {
              "$ref": "#/$defs/result_event"
            }
          },
          "required": [
            "status",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "rejected"
            },
            "error": {
              "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/error"
            }
          },
          "required": [
            "status",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
