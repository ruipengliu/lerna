{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.invalid/protocol/v1/common.schema.json",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "uint": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "uint0": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "uint64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "format": "harness-uint64"
    },
    "seq": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$",
      "format": "harness-uint64"
    },
    "time": {
      "type": "string",
      "format": "harness-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "name": {
      "type": "string",
      "maxLength": 192,
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*){2,}$"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "retry": {
          "enum": [
            "never",
            "same_message",
            "query_operation",
            "after_change"
          ]
        },
        "details": {
          "type": "object",
          "maxProperties": 32
        }
      },
      "required": [
        "code",
        "message",
        "retry"
      ],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "content_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "provider_endpoint": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "size": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "format": "harness-uint64"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "content_id",
        "provider_endpoint",
        "media_type",
        "size",
        "sha256"
      ],
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "type": {
          "enum": [
            "text",
            "number",
            "boolean",
            "choice"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 1,
          "maxItems": 64
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "max_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "id",
        "label",
        "type",
        "required"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "choice"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ]
          },
          "else": {
            "not": {
              "required": [
                "options"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "number"
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "min"
                  ]
                },
                {
                  "required": [
                    "max"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "max_length"
              ]
            }
          }
        }
      ]
    },
    "values": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ],
        "maxLength": 32768,
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "input_request": {
      "type": "object",
      "properties": {
        "input_request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "expires_at": {
          "type": "string",
          "format": "harness-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]\\.[0-9]{3}Z$"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "type": {
                "enum": [
                  "text",
                  "number",
                  "boolean",
                  "choice"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "minItems": 1,
                "maxItems": 64
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "max_length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            },
            "required": [
              "id",
              "label",
              "type",
              "required"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "choice"
                    }
                  }
                },
                "then": {
                  "required": [
                    "options"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "options"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "number"
                    }
                  }
                },
                "else": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "min"
                        ]
                      },
                      {
                        "required": [
                          "max"
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "text"
                    }
                  }
                },
                "else": {
                  "not": {
                    "required": [
                      "max_length"
                    ]
                  }
                }
              }
            ]
          },
          "minItems": 1,
          "maxItems": 64
        }
      },
      "required": [
        "input_request_id",
        "purpose",
        "expires_at",
        "fields"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_message_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "max_inflight_messages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "max_inflight_bytes": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "format": "harness-uint64"
        },
        "control_reserve_messages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "control_reserve_bytes": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "format": "harness-uint64"
        },
        "max_retention_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "max_message_bytes",
        "max_inflight_messages",
        "max_inflight_bytes",
        "control_reserve_messages",
        "control_reserve_bytes",
        "max_retention_seconds"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "maxLength": 192,
                "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*){2,}$"
              },
              "type_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "kinds": {
                "type": "array",
                "items": {
                  "enum": [
                    "request",
                    "response",
                    "event"
                  ]
                },
                "minItems": 1,
                "maxItems": 3,
                "uniqueItems": true
              }
            },
            "required": [
              "type",
              "type_version",
              "kinds"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 1024
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 192,
                "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*){2,}$"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            },
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 128
        },
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "maxLength": 192,
                "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*){2,}$"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            },
            "required": [
              "type",
              "version"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 128
        }
      },
      "required": [
        "messages",
        "extensions",
        "views"
      ],
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "properties": {
        "grant_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "grant_ref"
      ],
      "additionalProperties": false
    },
    "extension": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 192,
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*){2,}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "required": {
          "type": "boolean"
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "version",
        "required",
        "data"
      ],
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "maxLength": 192,
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*){2,}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "type",
        "version",
        "data"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "task",
            "operation",
            "surface"
          ]
        },
        "id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    }
  }
}
