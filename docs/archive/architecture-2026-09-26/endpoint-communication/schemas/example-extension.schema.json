{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.invalid/protocol/v1/example-extension.schema.json",
  "$defs": {
    "device_capture_arguments": {
      "type": "object",
      "properties": {
        "format": {
          "enum": [
            "png",
            "jpeg"
          ]
        }
      },
      "required": [
        "format"
      ],
      "additionalProperties": false
    },
    "capture_request": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "format": {
          "enum": [
            "png",
            "jpeg"
          ]
        }
      },
      "required": [
        "device_id",
        "format"
      ],
      "additionalProperties": false
    },
    "capture_response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "completed"
            },
            "result": {
              "type": "object",
              "properties": {
                "content": {
                  "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/content"
                }
              },
              "required": [
                "content"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "rejected"
            },
            "error": {
              "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/error"
            }
          },
          "required": [
            "status",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "trace": {
      "type": "object",
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "trace_id"
      ],
      "additionalProperties": false
    },
    "data_policy": {
      "type": "object",
      "properties": {
        "allow_cloud_processing": {
          "const": false
        }
      },
      "required": [
        "allow_cloud_processing"
      ],
      "additionalProperties": false
    },
    "preview": {
      "type": "object",
      "properties": {
        "content": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/content"
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "content"
      ],
      "additionalProperties": false
    }
  }
}
