{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.invalid/protocol/v1/domain-common.schema.json",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "proof_ref": {
      "type": "object",
      "properties": {
        "authority_endpoint": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "proof_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "revision": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/seq"
        },
        "binding_sha256": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/digest"
        },
        "issued_at": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/time"
        },
        "expires_at": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/time"
        }
      },
      "required": [
        "authority_endpoint",
        "proof_id",
        "revision",
        "binding_sha256",
        "issued_at",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "source_binding": {
      "type": "object",
      "properties": {
        "source_authority": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "resource_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "revision": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/seq"
        },
        "sha256": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/digest"
        },
        "observed_at": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/time"
        },
        "policy_ref": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "policy_revision": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/seq"
        },
        "purposes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 1,
          "maxItems": 64
        },
        "recipients": {
          "type": "array",
          "items": {
            "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "processing_endpoints": {
          "type": "array",
          "items": {
            "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "retain_until": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/time"
        },
        "current_proof": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/proof_ref"
        }
      },
      "required": [
        "source_authority",
        "resource_ref",
        "revision",
        "sha256",
        "observed_at",
        "policy_ref",
        "policy_revision",
        "purposes",
        "recipients",
        "processing_endpoints",
        "retain_until",
        "current_proof"
      ],
      "additionalProperties": false
    },
    "source_set": {
      "type": "array",
      "items": {
        "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/source_binding"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "money": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "minor_units": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uint64"
        },
        "scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      },
      "required": [
        "currency",
        "minor_units",
        "scale"
      ],
      "additionalProperties": false
    },
    "budget_amount": {
      "type": "object",
      "properties": {
        "dimension": {
          "enum": [
            "calls",
            "tokens",
            "bytes",
            "duration_ms",
            "cost"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "amount": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uint64"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      },
      "required": [
        "dimension",
        "unit",
        "amount"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "dimension": {
                "const": "cost"
              }
            }
          },
          "then": {
            "required": [
              "currency",
              "scale"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "currency"
                  ]
                },
                {
                  "required": [
                    "scale"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "budget": {
      "type": "object",
      "properties": {
        "budget_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "purpose": {
          "enum": [
            "goal",
            "recovery",
            "extraction",
            "evaluation"
          ]
        },
        "mode": {
          "enum": [
            "hard",
            "estimated"
          ]
        },
        "limits": {
          "type": "array",
          "items": {
            "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/budget_amount"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "reservation_proof": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/proof_ref"
        }
      },
      "required": [
        "budget_id",
        "purpose",
        "mode",
        "limits",
        "reservation_proof"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "item_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "source_endpoint": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "revision": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/seq"
        },
        "amount": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/budget_amount"
        },
        "cumulative": {
          "const": true
        },
        "final": {
          "type": "boolean"
        },
        "proof": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/proof_ref"
        }
      },
      "required": [
        "item_id",
        "source_endpoint",
        "revision",
        "amount",
        "cumulative",
        "final",
        "proof"
      ],
      "additionalProperties": false
    },
    "control_binding": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "authority_endpoint": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "owner_endpoint": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "owner_epoch": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/seq"
        },
        "control_revision": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/seq"
        },
        "proof": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/proof_ref"
        },
        "control": {
          "$ref": "https://harness.invalid/protocol/v1/task-control.schema.json#/$defs/control"
        },
        "cancel_requested": {
          "type": "boolean"
        }
      },
      "required": [
        "task_id",
        "authority_endpoint",
        "owner_endpoint",
        "owner_epoch",
        "control_revision",
        "proof",
        "control",
        "cancel_requested"
      ],
      "additionalProperties": false
    },
    "operation_basis": {
      "type": "object",
      "properties": {
        "operation_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "authority_endpoint": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "actor_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "processor_endpoint": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "intent_sha256": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/digest"
        },
        "source_bindings": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/source_set"
        },
        "sources_sha256": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/digest"
        },
        "budget": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/budget"
        },
        "control": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/control_binding"
        },
        "proof": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/proof_ref"
        }
      },
      "required": [
        "operation_id",
        "authority_endpoint",
        "actor_id",
        "processor_endpoint",
        "intent_sha256",
        "source_bindings",
        "sources_sha256",
        "proof"
      ],
      "additionalProperties": false
    },
    "gap": {
      "type": "object",
      "properties": {
        "reason": {
          "enum": [
            "unavailable",
            "expired",
            "incomplete",
            "closed",
            "forbidden",
            "owner_changed",
            "history_lost",
            "not_observed",
            "conflict",
            "unsupported"
          ]
        },
        "authority_endpoint": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "retry": {
          "enum": [
            "same_request",
            "new_recovery",
            "after_change",
            "none"
          ]
        }
      },
      "required": [
        "reason",
        "authority_endpoint",
        "retry"
      ],
      "additionalProperties": false
    },
    "command_ref": {
      "type": "object",
      "properties": {
        "command_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "intent_sha256": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/digest"
        }
      },
      "required": [
        "command_id",
        "intent_sha256"
      ],
      "additionalProperties": false
    },
    "command_receipt": {
      "type": "object",
      "properties": {
        "command_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "intent_sha256": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/digest"
        },
        "authority_endpoint": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "state": {
          "enum": [
            "committed",
            "rejected",
            "not_observed",
            "closed_without_commit",
            "history_lost"
          ]
        },
        "revision": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/seq"
        },
        "result_ref": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/proof_ref"
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/gap"
          },
          "minItems": 0,
          "maxItems": 64
        }
      },
      "required": [
        "command_id",
        "intent_sha256",
        "authority_endpoint",
        "state",
        "gaps"
      ],
      "additionalProperties": false
    },
    "recovery_binding": {
      "type": "object",
      "properties": {
        "recovery_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "authority_endpoint": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "endpoint_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "owner_generation": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/seq"
        },
        "ledger_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "selection_sha256": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/digest"
        },
        "expires_at": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/time"
        }
      },
      "required": [
        "recovery_id",
        "authority_endpoint",
        "endpoint_id",
        "owner_generation",
        "ledger_id",
        "selection_sha256",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "page_position": {
      "type": "object",
      "properties": {
        "snapshot_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "cut": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uint64"
        },
        "page_index": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uint0"
        },
        "page_count": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uint"
        },
        "page_sha256": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/digest"
        },
        "manifest_sha256": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/digest"
        },
        "next_cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "snapshot_id",
        "cut",
        "page_index",
        "page_count",
        "page_sha256",
        "manifest_sha256"
      ],
      "additionalProperties": false
    },
    "rejected": {
      "type": "object",
      "properties": {
        "status": {
          "const": "rejected"
        },
        "error": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/error"
        }
      },
      "required": [
        "status",
        "error"
      ],
      "additionalProperties": false
    },
    "uuid": {
      "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
    },
    "revision": {
      "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/seq"
    },
    "timestamp": {
      "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/time"
    },
    "content": {
      "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/content"
    },
    "source_bindings": {
      "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/source_set"
    },
    "endpoint": {
      "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
    },
    "source_ref": {
      "type": "object",
      "properties": {
        "source_authority": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "resource_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "revision": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/seq"
        },
        "sha256": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/digest"
        }
      },
      "required": [
        "source_authority",
        "resource_ref",
        "revision",
        "sha256"
      ],
      "additionalProperties": false
    },
    "preview_receipt": {
      "type": "object",
      "properties": {
        "host_endpoint": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "surface_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "ui_operation_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "task_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "input_request_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "projection_revision": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/seq"
        },
        "previews": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "preview_id": {
                "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
              },
              "content_sha256": {
                "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/digest"
              }
            },
            "required": [
              "preview_id",
              "content_sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 64
        },
        "acquired_at": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/time"
        },
        "expires_at": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/time"
        },
        "proof": {
          "$ref": "https://harness.invalid/protocol/v1/domain-common.schema.json#/$defs/proof_ref"
        }
      },
      "required": [
        "host_endpoint",
        "surface_id",
        "ui_operation_id",
        "task_id",
        "input_request_id",
        "projection_revision",
        "previews",
        "acquired_at",
        "expires_at",
        "proof"
      ],
      "additionalProperties": false
    }
  }
}
