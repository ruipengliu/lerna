{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.invalid/protocol/v1/http.schema.json",
  "$defs": {
    "connect_ticket_request": {
      "type": "object",
      "properties": {
        "endpoint_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        }
      },
      "required": [
        "endpoint_id"
      ],
      "additionalProperties": false
    },
    "connect_ticket_response": {
      "type": "object",
      "properties": {
        "ticket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "expires_at": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/time"
        },
        "websocket_url": {
          "type": "string",
          "pattern": "^wss://[^/]+/harness/v1/connect$"
        },
        "gateway_endpoint_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        }
      },
      "required": [
        "ticket",
        "expires_at",
        "websocket_url",
        "gateway_endpoint_id"
      ],
      "additionalProperties": false
    },
    "content_response": {
      "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/content"
    },
    "error_response": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/error"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "bootstrap_request": {
      "type": "object",
      "properties": {
        "endpoint_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "requested_authority": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        }
      },
      "required": [
        "endpoint_id",
        "requested_authority"
      ],
      "additionalProperties": false
    },
    "bootstrap_response": {
      "type": "object",
      "properties": {
        "bootstrap_grant_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "authority_endpoint": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "endpoint_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "owner_generation": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/seq"
        },
        "ledger_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "expires_at": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/time"
        },
        "allowed_types": {
          "type": "array",
          "items": {
            "enum": [
              "harness.authorization.open_recovery",
              "harness.authorization.read_recovery",
              "harness.authorization.read_changes",
              "harness.authorization.apply_recovery",
              "harness.authorization.query_command"
            ]
          },
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true
        }
      },
      "required": [
        "bootstrap_grant_ref",
        "authority_endpoint",
        "endpoint_id",
        "owner_generation",
        "ledger_id",
        "expires_at",
        "allowed_types"
      ],
      "additionalProperties": false
    },
    "management_grant_request": {
      "type": "object",
      "properties": {
        "endpoint_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "requested_authority": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "allowed_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 19,
          "uniqueItems": true,
          "items": {
            "enum": [
              "harness.authorization.create_confirmation",
              "harness.authorization.confirm",
              "harness.authorization.query_confirmation",
              "harness.authorization.revoke",
              "harness.authorization.query_state",
              "harness.authorization.query_command",
              "harness.memory.mutate",
              "harness.memory.query_command",
              "harness.memory.close_command",
              "harness.memory.set_extraction_policy",
              "harness.governance.close_source",
              "harness.governance.close_holder",
              "harness.governance.query_cleanup",
              "harness.content.close",
              "harness.content.query_cleanup",
              "harness.execution.manage",
              "harness.execution.query_management",
              "harness.execution.reopen_device",
              "harness.execution.query_device_command"
            ]
          }
        }
      },
      "required": [
        "endpoint_id",
        "requested_authority",
        "allowed_types"
      ],
      "additionalProperties": false
    },
    "management_grant_response": {
      "type": "object",
      "properties": {
        "authority_endpoint": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "endpoint_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "owner_generation": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/seq"
        },
        "ledger_id": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/uuid"
        },
        "expires_at": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/time"
        },
        "allowed_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 19,
          "uniqueItems": true,
          "items": {
            "enum": [
              "harness.authorization.create_confirmation",
              "harness.authorization.confirm",
              "harness.authorization.query_confirmation",
              "harness.authorization.revoke",
              "harness.authorization.query_state",
              "harness.authorization.query_command",
              "harness.memory.mutate",
              "harness.memory.query_command",
              "harness.memory.close_command",
              "harness.memory.set_extraction_policy",
              "harness.governance.close_source",
              "harness.governance.close_holder",
              "harness.governance.query_cleanup",
              "harness.content.close",
              "harness.content.query_cleanup",
              "harness.execution.manage",
              "harness.execution.query_management",
              "harness.execution.reopen_device",
              "harness.execution.query_device_command"
            ]
          }
        },
        "management_grant_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "recent_auth_until": {
          "$ref": "https://harness.invalid/protocol/v1/common.schema.json#/$defs/time"
        }
      },
      "required": [
        "management_grant_ref",
        "authority_endpoint",
        "endpoint_id",
        "owner_generation",
        "ledger_id",
        "expires_at",
        "allowed_types",
        "recent_auth_until"
      ],
      "additionalProperties": false
    }
  }
}
