{
  "name": "harness-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "generate": "node sdk/ts/scripts/generate-contracts.mjs",
    "generate:check": "node sdk/ts/scripts/generate-contracts.mjs --check",
    "fmt": "biome format --write sdk/ts apps/web package.json pnpm-workspace.yaml biome.json vitest.config.ts",
    "fmt:check": "biome format sdk/ts apps/web package.json pnpm-workspace.yaml biome.json vitest.config.ts",
    "lint": "biome lint sdk/ts apps/web vitest.config.ts",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "build": "pnpm -r build",
    "dev": "pnpm --filter @harness/web dev",
    "test:browser": "pnpm --filter @harness/web test:browser"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.12.0",
    "fake-indexeddb": "6.2.5",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "ws": "8.19.0",
    "@types/ws": "8.18.1"
  }
}
