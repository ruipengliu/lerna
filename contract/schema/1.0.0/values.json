{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lerna.dev/contract/1.0.0/values.json",
  "$defs": {
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "Revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "format": "int64-decimal"
    },
    "Time": {
      "type": "string",
      "format": "utc-microseconds"
    },
    "Kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "OwnerRef": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/ID"
        },
        "owner_id": {
          "$ref": "#/$defs/ID"
        }
      },
      "required": ["tenant_id", "owner_id"],
      "additionalProperties": false
    },
    "ObjectRef": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/ID"
        },
        "owner_id": {
          "$ref": "#/$defs/ID"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "id": {
          "$ref": "#/$defs/ID"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": ["tenant_id", "owner_id", "kind", "id"],
      "additionalProperties": false
    },
    "ContentRef": {
      "type": "object",
      "properties": {
        "owner": {
          "$ref": "#/$defs/OwnerRef"
        },
        "content_id": {
          "$ref": "#/$defs/ID"
        },
        "version": {
          "$ref": "#/$defs/Revision"
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
        },
        "byte_length": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "owner",
        "content_id",
        "version",
        "hash",
        "media_type",
        "byte_length"
      ],
      "additionalProperties": false
    },
    "Amount": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
        },
        "integer_value": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": ["unit", "integer_value"],
      "additionalProperties": false
    },
    "Gap": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "enum": ["retention", "authorization_changed", "source_unavailable"]
        }
      },
      "required": ["reason"],
      "additionalProperties": false
    },
    "ReadScope": {
      "type": "object",
      "properties": {
        "owner": {
          "$ref": "#/$defs/OwnerRef"
        },
        "object_type": {
          "$ref": "#/$defs/Kind"
        }
      },
      "required": ["owner", "object_type"],
      "additionalProperties": false
    },
    "CollectionView": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "maxItems": 1000
        },
        "cursor": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 4096
        },
        "exhausted": {
          "type": "boolean"
        },
        "partial": {
          "type": "boolean"
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Gap"
          },
          "maxItems": 100
        },
        "read_scope": {
          "$ref": "#/$defs/ReadScope"
        },
        "watermark": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "items",
        "cursor",
        "exhausted",
        "partial",
        "gaps",
        "read_scope",
        "watermark"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "exhausted": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "cursor": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "cursor": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "partial": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "gaps": {
                "maxItems": 0,
                "type": "array"
              }
            }
          },
          "else": {
            "properties": {
              "gaps": {
                "minItems": 1,
                "type": "array"
              }
            }
          }
        }
      ]
    }
  }
}
