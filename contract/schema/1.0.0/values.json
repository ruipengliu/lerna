{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lerna.dev/contract/1.0.0/values.json",
  "$defs": {
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "Revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "format": "int64-decimal"
    },
    "Time": {
      "type": "string",
      "format": "utc-microseconds"
    },
    "Kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "OwnerRef": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/ID"
        },
        "owner_id": {
          "$ref": "#/$defs/ID"
        }
      },
      "required": ["tenant_id", "owner_id"],
      "additionalProperties": false
    },
    "ObjectRef": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/ID"
        },
        "owner_id": {
          "$ref": "#/$defs/ID"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "id": {
          "$ref": "#/$defs/ID"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": ["tenant_id", "owner_id", "kind", "id"],
      "additionalProperties": false
    },
    "ContentRef": {
      "type": "object",
      "properties": {
        "owner": {
          "$ref": "#/$defs/OwnerRef"
        },
        "content_id": {
          "$ref": "#/$defs/ID"
        },
        "version": {
          "$ref": "#/$defs/Revision"
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
        },
        "byte_length": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "owner",
        "content_id",
        "version",
        "hash",
        "media_type",
        "byte_length"
      ],
      "additionalProperties": false
    },
    "Amount": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
        },
        "integer_value": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": ["unit", "integer_value"],
      "additionalProperties": false
    },
    "Gap": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "enum": ["retention", "authorization_changed", "source_unavailable"]
        }
      },
      "required": ["reason"],
      "additionalProperties": false
    },
    "ReadScope": {
      "type": "object",
      "properties": {
        "owner": {
          "$ref": "#/$defs/OwnerRef"
        },
        "object_type": {
          "$ref": "#/$defs/Kind"
        }
      },
      "required": ["owner", "object_type"],
      "additionalProperties": false
    },
    "CollectionView": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "maxItems": 1000
        },
        "cursor": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 4096
        },
        "exhausted": {
          "type": "boolean"
        },
        "partial": {
          "type": "boolean"
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Gap"
          },
          "maxItems": 100
        },
        "read_scope": {
          "$ref": "#/$defs/ReadScope"
        },
        "watermark": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "items",
        "cursor",
        "exhausted",
        "partial",
        "gaps",
        "read_scope",
        "watermark"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "exhausted": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "cursor": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "cursor": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "partial": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "gaps": {
                "maxItems": 0,
                "type": "array"
              }
            }
          },
          "else": {
            "properties": {
              "gaps": {
                "minItems": 1,
                "type": "array"
              }
            }
          }
        }
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "schema_invalid",
        "version_unsupported",
        "forbidden",
        "expired",
        "idempotency_conflict",
        "revision_changed",
        "budget_exhausted",
        "dependency_unavailable",
        "unsupported"
      ]
    },
    "PublicError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        }
      },
      "required": ["code"],
      "additionalProperties": false
    },
    "MethodName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,31}$"
    },
    "ProfileName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "ContractVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "TraceContext": {
      "type": "object",
      "properties": {
        "trace_id": {
          "$ref": "#/$defs/ID"
        }
      },
      "required": ["trace_id"],
      "additionalProperties": false
    },
    "CommandPayload": {
      "type": "object",
      "additionalProperties": true,
      "maxProperties": 1024
    },
    "CommandEnvelope": {
      "type": "object",
      "properties": {
        "contract_version": {
          "$ref": "#/$defs/ContractVersion"
        },
        "profile": {
          "$ref": "#/$defs/ProfileName"
        },
        "command_id": {
          "$ref": "#/$defs/ID"
        },
        "target": {
          "$ref": "#/$defs/ObjectRef"
        },
        "method": {
          "$ref": "#/$defs/MethodName"
        },
        "payload": {
          "$ref": "#/$defs/CommandPayload"
        },
        "accept_before": {
          "$ref": "#/$defs/Time"
        },
        "expected_revision": {
          "$ref": "#/$defs/Revision"
        },
        "trace_context": {
          "$ref": "#/$defs/TraceContext"
        }
      },
      "required": [
        "contract_version",
        "profile",
        "command_id",
        "target",
        "method",
        "payload",
        "accept_before"
      ],
      "additionalProperties": false
    },
    "CommandRef": {
      "type": "object",
      "properties": {
        "owner": {
          "$ref": "#/$defs/OwnerRef"
        },
        "command_id": {
          "$ref": "#/$defs/ID"
        }
      },
      "required": ["owner", "command_id"],
      "additionalProperties": false
    },
    "CommandGetPayload": {
      "type": "object",
      "properties": {
        "command_ref": {
          "$ref": "#/$defs/CommandRef"
        }
      },
      "required": ["command_ref"],
      "additionalProperties": false
    },
    "CommandGetRequest": {
      "type": "object",
      "properties": {
        "contract_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "profile": {
          "type": "string",
          "const": "command"
        },
        "command_id": {
          "$ref": "#/$defs/ID"
        },
        "target": {
          "$ref": "#/$defs/CommandTarget"
        },
        "method": {
          "type": "string",
          "const": "command.get"
        },
        "payload": {
          "$ref": "#/$defs/CommandGetPayload"
        },
        "accept_before": {
          "$ref": "#/$defs/Time"
        },
        "trace_context": {
          "$ref": "#/$defs/TraceContext"
        }
      },
      "required": [
        "contract_version",
        "profile",
        "command_id",
        "target",
        "method",
        "payload",
        "accept_before"
      ],
      "additionalProperties": false
    },
    "CommandTarget": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/ID"
        },
        "owner_id": {
          "$ref": "#/$defs/ID"
        },
        "kind": {
          "type": "string",
          "const": "command"
        },
        "id": {
          "$ref": "#/$defs/ID"
        }
      },
      "required": ["tenant_id", "owner_id", "kind", "id"],
      "additionalProperties": false
    }
  }
}
